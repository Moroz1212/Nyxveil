# Force LF for all production shell / unit / conf text shipped to Linux.
# Do not rely on developer autocrlf alone.
*.sh text eol=lf
installer/**/*.sh text eol=lf
scripts/**/*.sh text eol=lf
firewall/** text eol=lf
systemd/** text eol=lf
docs/**/*.md text eol=lf
*.service text eol=lf
*.conf text eol=lf
