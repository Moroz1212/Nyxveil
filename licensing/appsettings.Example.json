{
  "ConnectionStrings": {
    "ControlPlane": "Server=YOUR_SQL_HOST;Database=NyxveilControlPlane;Trusted_Connection=True;TrustServerCertificate=False;Encrypt=True"
  },
  "Database": {
    "ConnectionString": "",
    "_comment_TrustSqlServerCertificate": "Remote default false. Local lab/dev may set true. Provider overrides TrustServerCertificate from this value (CS alone is not enough).",
    "Encrypt": true,
    "TrustSqlServerCertificate": false
  },
  "Hosting": {
    "_comment": "Hosting is the single source of truth for HTTPS listen (BindAddress+Port). Do NOT add Kestrel:Endpoints — that causes dual listen with ConfigureKestrel.",
    "BindAddress": "0.0.0.0",
    "Port": 8443,
    "PublicHostname": "control.example.com",
    "PublicBaseUrl": "https://control.example.com:8443"
  },
  "Certificate": {
    "_comment": "Preferred production shape after install/PFX import: Mode=Store + Thumbprint (LocalMachine\\My). ValidationMode is separate from Mode (load source).",
    "Mode": "Store",
    "ValidationMode": "SystemTrust",
    "Thumbprint": "",
    "StoreName": "My",
    "StoreLocation": "LocalMachine",
    "PfxPath": "",
    "PfxPasswordProtectedPath": ""
  },
  "Https": {
    "RequireHttpsInProduction": true
  },
  "Setup": {
    "AllowWebBootstrap": false,
    "BootstrapToken": ""
  },
  "Signing": {
    "Issuer": "nyxveil-control-plane",
    "Audience": "nvp-node",
    "KeyProtectionPath": "%PROGRAMDATA%\\Nyxveil\\ControlPlane\\keys"
  },
  "Tickets": {
    "TtlMinutes": 15
  },
  "NodeAuth": {
    "AllowLegacyBearer": false
  },
  "NodeHeartbeat": {
    "IntervalSeconds": 30,
    "DegradedAfterSeconds": 90,
    "OfflineAfterSeconds": 180
  },
  "MetricsRetention": {
    "RawDays": 30,
    "SnapshotMinutes": 5
  },
  "RateLimits": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "Burst": 30,
    "TicketPermitLimit": 60,
    "TicketWindowSeconds": 60
  },
  "Security": {
    "_comment_LicenseKekHex": "Prefer DPAPI file C:\\ProgramData\\Nyxveil\\ControlPlane\\secrets\\license-kek.dpapi in Production. Never commit real values.",
    "LicenseKekHex": ""
  },
  "UI": {
    "AppName": "Nyxveil Control Plane",
    "SupportUrl": null,
    "ShowTestNodes": true,
    "PathBase": "/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Enabled": true,
      "Directory": "%PROGRAMDATA%\\Nyxveil\\ControlPlane\\logs",
      "FilePrefix": "controlplane",
      "MaxFileSizeMB": 10,
      "MaxRetainedFiles": 14
    }
  },
  "AllowedHosts": "*"
}
