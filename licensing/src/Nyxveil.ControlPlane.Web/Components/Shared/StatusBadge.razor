@namespace Nyxveil.ControlPlane.Web.Components.Shared

<span class="status-badge status-@CssClass">@Label</span>

@code {
    [Parameter] public string Status { get; set; } = "";

    private string CssClass => Status.ToLowerInvariant() switch
    {
        "healthy" or "active" or "online" or "succeeded" => "healthy",
        "degraded" or "pending" or "expiring" or "claimed" or "running" or "executing" or "accepted" => "degraded",
        "offline" or "revoked" or "disabled" or "expired" or "failed" => "offline",
        "maintenance" or "draining" => "degraded",
        _ => "neutral"
    };

    private string Label => UiText.Status(Status);
}
