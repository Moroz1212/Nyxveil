@page "/Error"
@using System.Diagnostics
<PageTitle>Ошибка — Nyxveil</PageTitle>
<h1>Не удалось выполнить запрос</h1>
<p>Повторите попытку. Если ошибка повторяется, сообщите администратору идентификатор запроса.</p>
@if (!string.IsNullOrEmpty(RequestId))
{
    <p><strong>Идентификатор запроса:</strong> <code>@RequestId</code></p>
}
<a href="/">Вернуться к обзору</a>
@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private string? RequestId { get; set; }
    protected override void OnInitialized() => RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
