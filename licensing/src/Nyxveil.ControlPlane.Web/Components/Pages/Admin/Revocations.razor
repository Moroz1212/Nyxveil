@page "/admin/revocations"
@attribute [Authorize(Policy = AuthPolicies.AnyAdmin)]
@rendermode InteractiveServer
@inject IServiceScopeFactory Scopes

<div class="page-header">
    <div>
        <h1>Список отзывов</h1>
        <div class="sub">Отозванные билеты доступа, лицензии и устройства с версиями изменений.</div>
    </div>
</div>

<div class="toolbar">
    <input placeholder="Поиск по идентификатору объекта" @bind="_filter" @bind:event="oninput" />
</div>

<div class="table-wrap">
    <table class="data">
        <thead><tr><th>Версия</th><th>Тип</th><th>Объект отзыва</th><th>Причина</th><th>Автор</th><th>Создано (UTC)</th></tr></thead>
        <tbody>
        @foreach (var r in Filtered())
        {
            <tr>
                <td>@r.Version</td>
                <td>@UiText.Revocation(r.Type)</td>
                <td class="mono">@r.TargetId</td>
                <td>@(r.Reason ?? "—")</td>
                <td>@r.CreatedBy</td>
                <td>@r.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss 'UTC'")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private List<Revocation> _rows = new();
    private string _filter = "";

    protected override async Task OnInitializedAsync()
    {
        _rows = await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var db = sp.GetRequiredService<ControlPlaneDbContext>();
            return await db.Revocations.OrderByDescending(r => r.Version).Take(500).ToListAsync();
        });
    }

    private IEnumerable<Revocation> Filtered()
    {
        if (string.IsNullOrWhiteSpace(_filter)) return _rows;
        var f = _filter.Trim();
        return _rows.Where(r => r.TargetId.Contains(f, StringComparison.OrdinalIgnoreCase));
    }
}
