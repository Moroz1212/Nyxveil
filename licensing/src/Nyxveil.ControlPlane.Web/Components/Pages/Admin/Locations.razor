@page "/admin/locations"
@attribute [Authorize(Policy = AuthPolicies.AnyAdmin)]
@rendermode InteractiveServer
@inject ControlPlaneDbContext Db
@inject IClock Clock
@inject AuthenticationStateProvider AuthState
@inject IAuditService Audit

<div class="page-header">
    <div>
        <h1>Locations</h1>
        <div class="sub">Geographic locations used for catalog and ticket scope.</div>
    </div>
    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
        <button class="btn" @onclick="() => _showCreate = !_showCreate">@(_showCreate ? "Close" : "Add location")</button>
    </AuthorizeView>
</div>

@if (_showCreate)
{
    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
        <div class="panel form-grid">
            <label>Location id<input @bind="_id" /></label>
            <label>Code<input @bind="_code" /></label>
            <label>Country<input @bind="_country" /></label>
            <label>City<input @bind="_city" /></label>
            <label>Display name<input @bind="_display" /></label>
            <label>Sort order<input type="number" @bind="_sort" /></label>
            <div class="actions" style="align-self:end"><button class="btn" @onclick="CreateAsync">Save</button></div>
        </div>
    </AuthorizeView>
}

<div class="table-wrap">
    <table class="data">
        <thead><tr><th>Id</th><th>Code</th><th>Display</th><th>Country</th><th>City</th><th>Enabled</th><th>Sort</th><th></th></tr></thead>
        <tbody>
        @foreach (var loc in _locations)
        {
            <tr>
                <td class="mono">@loc.LocationId</td>
                <td>@loc.Code</td>
                <td>@loc.DisplayName</td>
                <td>@loc.Country</td>
                <td>@loc.City</td>
                <td>@(loc.Enabled ? "yes" : "no")</td>
                <td>@loc.SortOrder</td>
                <td>
                    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
                        <button class="btn btn-ghost btn-sm" @onclick="() => ToggleAsync(loc)">@(loc.Enabled ? "Disable" : "Enable")</button>
                    </AuthorizeView>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private List<Location> _locations = new();
    private bool _showCreate;
    private string _id = "";
    private string _code = "";
    private string _country = "";
    private string _city = "";
    private string _display = "";
    private int _sort;

    protected override async Task OnInitializedAsync() =>
        _locations = await Db.Locations.OrderBy(l => l.SortOrder).ThenBy(l => l.Code).ToListAsync();

    private async Task CreateAsync()
    {
        var now = Clock.UtcNow;
        var loc = new Location
        {
            LocationId = string.IsNullOrWhiteSpace(_id) ? _code.Trim() : _id.Trim(),
            Code = _code.Trim(),
            Country = _country.Trim(),
            City = _city.Trim(),
            DisplayName = string.IsNullOrWhiteSpace(_display) ? $"{_city}, {_country}" : _display.Trim(),
            Enabled = true,
            SortOrder = _sort,
            CreatedAt = now,
            UpdatedAt = now
        };
        Db.Locations.Add(loc);
        await Db.SaveChangesAsync();
        var state = await AuthState.GetAuthenticationStateAsync();
        await Audit.WriteAsync(new AuditWriteRequest
        {
            Actor = state.User.Identity?.Name ?? "admin",
            Action = "location.created",
            EntityType = "Location",
            EntityId = loc.LocationId
        });
        _showCreate = false;
        _locations = await Db.Locations.OrderBy(l => l.SortOrder).ThenBy(l => l.Code).ToListAsync();
    }

    private async Task ToggleAsync(Location loc)
    {
        loc.Enabled = !loc.Enabled;
        loc.UpdatedAt = Clock.UtcNow;
        await Db.SaveChangesAsync();
        _locations = await Db.Locations.OrderBy(l => l.SortOrder).ThenBy(l => l.Code).ToListAsync();
    }
}
