@page "/admin/users"
@attribute [Authorize(Policy = AuthPolicies.AnyAdmin)]
@rendermode InteractiveServer
@inject IServiceScopeFactory Scopes
@inject IClock Clock
@inject AuthenticationStateProvider AuthState

<div class="page-header">
    <div>
        <h1>Пользователи</h1>
        <div class="sub">Пользовательские учётные записи, связанные с лицензиями.</div>
    </div>
    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
        <button class="btn" @onclick="() => _showCreate = !_showCreate" disabled="@_busy">@(_showCreate ? "Закрыть" : "Добавить пользователя")</button>
    </AuthorizeView>
</div>

@if (_showCreate)
{
    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
        <div class="panel form-grid">
            <label>Электронная почта<input @bind="_email" /></label>
            <label>Отображаемое имя<input @bind="_displayName" /></label>
            <label>Внешний идентификатор<input @bind="_externalId" /></label>
            <div class="actions" style="align-self:end"><button class="btn" @onclick="CreateAsync" disabled="@_busy">Сохранить</button></div>
        </div>
    </AuthorizeView>
}

<div class="toolbar">
    <input placeholder="Поиск по почте, имени или внешнему идентификатору" @bind="_filter" @bind:event="oninput" />
</div>

<div class="table-wrap">
    <table class="data">
        <thead><tr><th>Идентификатор пользователя</th><th>Электронная почта</th><th>Название</th><th>Статус</th><th>Создано (UTC)</th></tr></thead>
        <tbody>
        @foreach (var u in Filtered())
        {
            <tr>
                <td class="mono">@u.UserId</td>
                <td>@(u.Email ?? "—")</td>
                <td>@(u.DisplayName ?? "—")</td>
                <td><StatusBadge Status="@u.Status" /></td>
                <td>@u.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss 'UTC'")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private List<UserAccount> _users = new();
    private string _filter = "";
    private bool _showCreate;
    private bool _busy;
    private string _email = "";
    private string _displayName = "";
    private string _externalId = "";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _users = await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var db = sp.GetRequiredService<ControlPlaneDbContext>();
            return await db.UserAccounts.OrderByDescending(u => u.CreatedAt).Take(500).ToListAsync();
        });
    }

    private IEnumerable<UserAccount> Filtered()
    {
        if (string.IsNullOrWhiteSpace(_filter)) return _users;
        var f = _filter.Trim();
        return _users.Where(u =>
            (u.Email?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (u.DisplayName?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (u.ExternalId?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            u.UserId.ToString().Contains(f, StringComparison.OrdinalIgnoreCase));
    }

    private async Task CreateAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var actor = state.User.Identity?.Name ?? "admin";
            var now = Clock.UtcNow;
            var email = string.IsNullOrWhiteSpace(_email) ? null : _email.Trim();
            var displayName = string.IsNullOrWhiteSpace(_displayName) ? null : _displayName.Trim();
            var externalId = string.IsNullOrWhiteSpace(_externalId) ? null : _externalId.Trim();

            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                var db = sp.GetRequiredService<ControlPlaneDbContext>();
                var audit = sp.GetRequiredService<IAuditService>();
                var user = new UserAccount
                {
                    UserId = Guid.NewGuid(),
                    Email = email,
                    DisplayName = displayName,
                    ExternalId = externalId,
                    Status = "Active",
                    CreatedAt = now,
                    UpdatedAt = now
                };
                db.UserAccounts.Add(user);
                await db.SaveChangesAsync();
                await audit.WriteAsync(new AuditWriteRequest
                {
                    Actor = actor,
                    Action = "user.created",
                    EntityType = "User",
                    EntityId = user.UserId.ToString()
                });
            });
            _showCreate = false;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
