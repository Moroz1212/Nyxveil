@page "/admin/nodes"
@attribute [Authorize(Policy = AuthPolicies.AnyAdmin)]
@rendermode InteractiveServer
@inject IServiceScopeFactory Scopes

<div class="page-header">
    <div>
        <h1>Серверы</h1>
        <div class="sub">VPN-серверы: состояние, нагрузка и доступная ёмкость. Время указано в UTC.</div>
    </div>
</div>

<div class="toolbar">
    <input placeholder="Поиск по серверу, локации или имени" @bind="_filter" @bind:event="oninput" />
    <label><input type="checkbox" @bind="_showTest" /> Показывать тестовые</label>
    <label><input type="checkbox" @bind="_showDeleted" /> Показывать удалённые</label>
    <select @bind="_lifecycleFilter">
        <option value="">Все состояния</option>
        @foreach (var state in Enum.GetNames<NodeLifecycleState>()) { <option value="@state">@state</option> }
    </select>
</div>

<div class="table-wrap">
    <table class="data">
        <thead>
            <tr>
                <th>Сервер</th>
                <th>Локация</th>
                <th>Статус</th>
                <th>CPU</th>
                <th>Память</th>
                <th>Сеансы</th>
                <th>Версия</th>
                <th>Актуальная</th>
                <th>Статус версии</th>
                <th>TLS</th>
                <th>Сертификат</th>
                <th>Протокол</th>
                <th>Последняя связь (UTC)</th>
                <th>Режимы</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var n in Filtered())
        {
            <tr>
                <td><a href="@($"/admin/nodes/{Uri.EscapeDataString(n.Node.NodeId)}")">@n.Node.DisplayName</a><div class="mono muted">@n.Node.NodeId</div></td>
                <td>@n.Node.LocationId</td>
                <td><StatusBadge Status="@n.Node.Status.ToString()" /> <span class="muted">@n.Node.LifecycleState</span></td>
                <td>@(n.Health?.CpuPercent.ToString("0.0", UiText.Culture) ?? "—")%</td>
                <td>@(n.Health?.MemoryPercent.ToString("0.0", UiText.Culture) ?? "—")%</td>
                <td>@n.Node.CurrentSessions / @n.Node.Capacity</td>
                <td>@InstalledVersion(n.Node)</td>
                <td>@(_latest ?? "—")</td>
                <td>@VersionStatusLabel(n.Node)</td>
                <td>@TlsBadge(n)</td>
                <td>@CertDays(n.Node)</td>
                <td>@n.Node.ProtocolVersion</td>
                <td>@(n.Node.LastSeenAt?.ToString("dd.MM.yyyy HH:mm:ss 'UTC'") ?? "—")</td>
                <td>
                    @(n.Node.Enabled ? "" : "отключён ")
                    @(n.Node.Draining ? "завершение сеансов " : "")
                    @(n.Node.TestOnly ? "тестовый" : "")
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private sealed record Row(Node Node, NodeHealth? Health);

    private List<Row> _rows = new();
    private string _filter = "";
    private bool _showTest = true;
    private bool _showDeleted;
    private string _lifecycleFilter = "";
    private string? _latest;
    private string? _minSupported;

    protected override async Task OnInitializedAsync()
    {
        await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var db = sp.GetRequiredService<ControlPlaneDbContext>();
            var nodes = await db.Nodes.OrderBy(n => n.LocationId).ThenBy(n => n.DisplayName).ToListAsync();
            var health = await db.NodeHealth.ToDictionaryAsync(h => h.NodeId);
            _rows = nodes.Select(n => new Row(n, health.GetValueOrDefault(n.NodeId))).ToList();
            var release = await sp.GetRequiredService<IServerReleaseService>().GetLatestAsync();
            _latest = release.LatestVersion;
            _minSupported = sp.GetRequiredService<Microsoft.Extensions.Options.IOptions<Nyxveil.ControlPlane.Application.Options.ServerReleasePolicyOptions>>()
                .Value.MinimumSupportedVersion;
        });
    }

    private IEnumerable<Row> Filtered()
    {
        IEnumerable<Row> q = _rows;
        if (!_showTest) q = q.Where(r => !r.Node.TestOnly);
        if (!_showDeleted) q = q.Where(r => r.Node.LifecycleState != NodeLifecycleState.Deleted);
        if (!string.IsNullOrWhiteSpace(_lifecycleFilter) &&
            Enum.TryParse<NodeLifecycleState>(_lifecycleFilter, out var lifecycle))
            q = q.Where(r => r.Node.LifecycleState == lifecycle);
        if (!string.IsNullOrWhiteSpace(_filter))
        {
            var f = _filter.Trim();
            q = q.Where(r =>
                r.Node.NodeId.Contains(f, StringComparison.OrdinalIgnoreCase) ||
                r.Node.DisplayName.Contains(f, StringComparison.OrdinalIgnoreCase) ||
                r.Node.LocationId.Contains(f, StringComparison.OrdinalIgnoreCase));
        }
        return q;
    }

    private static string InstalledVersion(Node node) =>
        NodeVersionEvaluator.EffectiveInstalledVersion(node.ReportedServerVersion, node.ServerVersion) ?? "—";

    private string VersionStatusLabel(Node node)
    {
        var installed = NodeVersionEvaluator.EffectiveInstalledVersion(node.ReportedServerVersion, node.ServerVersion);
        var status = NodeVersionEvaluator.Evaluate(installed, _latest, _minSupported);
        return NodeVersionEvaluator.DisplayRu(status);
    }

    private static string CertDays(Node node)
    {
        var health = CertificateExpiry.Evaluate(node.CertNotAfter, DateTime.UtcNow);
        var days = CertificateExpiry.DaysRemaining(node.CertNotAfter, DateTime.UtcNow);
        if (health == CertificateHealthStatus.Expired) return "Истёк";
        if (days is null) return "—";
        return $"{days} дн.";
    }

    private static string TlsBadge(Row n)
    {
        if (n.Health?.TlsOk == true) return "OK";
        if (n.Health?.TlsOk == false) return "FAIL";
        var health = CertificateExpiry.Evaluate(n.Node.CertNotAfter, DateTime.UtcNow);
        return health switch
        {
            CertificateHealthStatus.Healthy => "OK",
            CertificateHealthStatus.ExpiringSoon => "Warn",
            CertificateHealthStatus.Critical => "Crit",
            CertificateHealthStatus.Expired => "Expired",
            _ => "—"
        };
    }
}
