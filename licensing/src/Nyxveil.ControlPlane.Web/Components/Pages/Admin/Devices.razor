@page "/admin/devices"
@attribute [Authorize(Policy = AuthPolicies.AnyAdmin)]
@rendermode InteractiveServer
@inject IServiceScopeFactory Scopes

<div class="page-header">
    <div>
        <h1>Устройства</h1>
        <div class="sub">Активированные клиентские устройства, привязанные к лицензиям.</div>
    </div>
</div>

<div class="toolbar">
    <input placeholder="Поиск по устройству, лицензии или платформе" @bind="_filter" @bind:event="oninput" />
</div>

<div class="table-wrap">
    <table class="data">
        <thead>
            <tr>
                <th>Устройство</th>
                <th>Лицензия</th>
                <th>Платформа</th>
                <th>Название</th>
                <th>Статус</th>
                <th>Последняя связь (UTC)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var d in Filtered())
        {
            <tr>
                <td class="mono">@d.ClientDeviceId</td>
                <td class="mono">@LicenseIdFormat.ToPublicId(d.LicenseId)</td>
                <td>@(d.Platform ?? "—")</td>
                <td>@(d.DeviceName ?? "—")</td>
                <td><StatusBadge Status="@d.Status.ToString()" /></td>
                <td>@(d.LastSeenAt?.ToString("dd.MM.yyyy HH:mm:ss 'UTC'") ?? "—")</td>
                <td>
                    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
                        @if (d.Status == DeviceStatus.Active)
                        {
                            <button class="btn btn-danger btn-sm" @onclick="() => AskRevoke(d.ClientDeviceId)" disabled="@_busy">Отозвать</button>
                        }
                    </AuthorizeView>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<ConfirmDialog @bind-Visible="_confirm"
               Title="Отозвать устройство"
               Message="Отозвать доступ этого устройства и добавить его в список отзывов?"
               ConfirmText="Отозвать"
               OnConfirm="ConfirmRevokeAsync" />

@code {
    private List<Device> _devices = new();
    private string _filter = "";
    private bool _confirm;
    private bool _busy;
    private string _revokeId = "";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _devices = await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var db = sp.GetRequiredService<ControlPlaneDbContext>();
            return await db.Devices.OrderByDescending(d => d.CreatedAt).Take(500).ToListAsync();
        });
    }

    private IEnumerable<Device> Filtered()
    {
        if (string.IsNullOrWhiteSpace(_filter)) return _devices;
        var f = _filter.Trim();
        return _devices.Where(d =>
            d.ClientDeviceId.Contains(f, StringComparison.OrdinalIgnoreCase) ||
            LicenseIdFormat.ToPublicId(d.LicenseId).Contains(f, StringComparison.OrdinalIgnoreCase) ||
            (d.Platform?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (d.DeviceName?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false));
    }

    private void AskRevoke(string id)
    {
        if (_busy) return;
        _revokeId = id;
        _confirm = true;
    }

    private async Task ConfirmRevokeAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var revokeId = _revokeId;
            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                var deviceService = sp.GetRequiredService<IDeviceService>();
                await deviceService.RevokeAsync(revokeId);
            });
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
