@page "/admin/audit"
@attribute [Authorize(Policy = AuthPolicies.AnyAdmin)]
@rendermode InteractiveServer
@inject IServiceScopeFactory Scopes

<div class="page-header">
    <div>
        <h1>Журнал действий</h1>
        <div class="sub">Действия администраторов и события безопасности. Время указано в UTC.</div>
    </div>
</div>

<div class="toolbar">
    <input placeholder="Поиск по исполнителю, действию или объекту" @bind="_filter" @bind:event="oninput" />
</div>

<div class="table-wrap">
    <table class="data">
        <thead><tr><th>Время (UTC)</th><th>Исполнитель</th><th>Действие</th><th>Объект</th><th>Идентификатор</th><th>IP</th><th>Подробности</th></tr></thead>
        <tbody>
        @foreach (var e in Filtered())
        {
            <tr>
                <td>@e.Timestamp.ToString("dd.MM.yyyy HH:mm:ss 'UTC'")</td>
                <td>@e.Actor</td>
                <td>@e.Action</td>
                <td>@e.EntityType</td>
                <td class="mono">@(e.EntityId ?? "—")</td>
                <td>@(e.IpAddress ?? "—")</td>
                <td>@(e.DetailsJson ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private List<AuditLogEntry> _rows = new();
    private string _filter = "";

    protected override async Task OnInitializedAsync()
    {
        _rows = await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var db = sp.GetRequiredService<ControlPlaneDbContext>();
            return await db.AuditLog.OrderByDescending(a => a.Timestamp).Take(500).ToListAsync();
        });
    }

    private IEnumerable<AuditLogEntry> Filtered()
    {
        if (string.IsNullOrWhiteSpace(_filter)) return _rows;
        var f = _filter.Trim();
        return _rows.Where(e =>
            e.Actor.Contains(f, StringComparison.OrdinalIgnoreCase) ||
            e.Action.Contains(f, StringComparison.OrdinalIgnoreCase) ||
            e.EntityType.Contains(f, StringComparison.OrdinalIgnoreCase) ||
            (e.EntityId?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false));
    }
}
