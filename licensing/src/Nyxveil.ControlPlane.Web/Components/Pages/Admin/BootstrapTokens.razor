@page "/admin/bootstrap-tokens"
@attribute [Authorize(Policy = AuthPolicies.AnyAdmin)]
@rendermode InteractiveServer
@inject IBootstrapTokenService Bootstrap
@inject AuthenticationStateProvider AuthState

<div class="page-header">
    <div>
        <h1>Bootstrap tokens</h1>
        <div class="sub">One-time (or limited-use) tokens for node registration.</div>
    </div>
    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
        <button class="btn" @onclick="() => _showCreate = !_showCreate">@(_showCreate ? "Close" : "Create token")</button>
    </AuthorizeView>
</div>

@if (!string.IsNullOrEmpty(_rawToken))
{
    <div class="alert alert-warn">
        <strong>Save this bootstrap token now.</strong> It will not be shown again.
        <div class="mono" style="margin-top:.5rem">@_rawToken</div>
        <button class="btn btn-ghost btn-sm" style="margin-top:.5rem" @onclick="() => _rawToken = null">Dismiss</button>
    </div>
}

@if (_showCreate)
{
    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
        <div class="panel form-grid">
            <label>Expires at (UTC)<input type="datetime-local" @bind="_expiresLocal" /></label>
            <label>Max uses<input type="number" min="1" @bind="_maxUses" /></label>
            <label>Allowed location<input @bind="_allowedLocation" /></label>
            <label>Note<input @bind="_note" /></label>
            <div class="actions" style="align-self:end"><button class="btn" @onclick="CreateAsync">Create</button></div>
        </div>
    </AuthorizeView>
}

<div class="table-wrap">
    <table class="data">
        <thead><tr><th>Id</th><th>Status</th><th>Uses</th><th>Location</th><th>Expires</th><th>Created</th><th>By</th></tr></thead>
        <tbody>
        @foreach (var t in _items)
        {
            <tr>
                <td class="mono">@t.BootstrapId</td>
                <td><StatusBadge Status="@t.Status" /></td>
                <td>@t.UsedCount / @t.MaxUses</td>
                <td>@(t.AllowedLocation ?? "—")</td>
                <td>@t.ExpiresAt.ToString("u")</td>
                <td>@t.CreatedAt.ToString("u")</td>
                <td>@t.CreatedBy</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private List<BootstrapTokenListItemDto> _items = new();
    private bool _showCreate;
    private string? _rawToken;
    private DateTime _expiresLocal = DateTime.UtcNow.AddDays(7);
    private int _maxUses = 1;
    private string _allowedLocation = "";
    private string _note = "";

    protected override async Task OnInitializedAsync() =>
        _items = (await Bootstrap.ListAsync()).ToList();

    private async Task CreateAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var resp = await Bootstrap.CreateAsync(new CreateBootstrapTokenRequest
        {
            ExpiresAt = DateTime.SpecifyKind(_expiresLocal, DateTimeKind.Utc),
            MaxUses = Math.Max(1, _maxUses),
            AllowedLocation = string.IsNullOrWhiteSpace(_allowedLocation) ? null : _allowedLocation.Trim(),
            Note = string.IsNullOrWhiteSpace(_note) ? null : _note.Trim(),
            CreatedBy = state.User.Identity?.Name ?? "admin"
        });
        _rawToken = resp.BootstrapToken;
        _showCreate = false;
        _items = (await Bootstrap.ListAsync()).ToList();
    }
}
