@page "/admin/signing-keys"
@attribute [Authorize(Policy = AuthPolicies.SuperAdminOnly)]
@rendermode InteractiveServer
@inject IServiceScopeFactory Scopes
@inject AuthenticationStateProvider AuthState

<div class="page-header">
    <div>
        <h1>Ключи подписи</h1>
        <div class="sub">Ключи Ed25519 для подписи каталога и билетов доступа. Только для главного администратора.</div>
    </div>
    <button class="btn btn-danger" @onclick="() => _confirm = true" disabled="@_busy">Сменить ключ</button>
</div>

@if (_current is not null)
{
    <div class="panel">
        <p><strong>Идентификатор текущего ключа:</strong> <span class="mono">@_current.KeyId</span></p>
        <p class="muted">Открытый ключ (HEX)</p>
        <div class="mono">@Convert.ToHexString(_current.PublicKey)</div>
    </div>
}

<div class="table-wrap">
    <table class="data">
        <thead><tr><th>Идентификатор ключа</th><th>Статус</th><th>Открытый ключ</th></tr></thead>
        <tbody>
        @foreach (var k in _keys)
        {
            <tr>
                <td class="mono">@k.KeyId</td>
                <td><StatusBadge Status="@k.Status" /></td>
                <td class="mono">@Convert.ToHexString(k.PublicKey)</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<ConfirmDialog @bind-Visible="_confirm"
               Title="Сменить ключ подписи"
               Message="Сменить текущий ключ подписи Ed25519? Предыдущий ключ останется доступен для проверки до вывода из обращения."
               ConfirmText="Сменить"
               OnConfirm="RotateAsync" />

@code {
    private SigningMaterialDto? _current;
    private List<VerificationKeyDto> _keys = new();
    private bool _confirm;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var signingKeyService = sp.GetRequiredService<ISigningKeyService>();
            try
            {
                _current = await signingKeyService.GetCurrentSigningMaterialAsync();
            }
            catch
            {
                _current = null;
            }

            _keys = (await signingKeyService.GetVerificationKeysAsync()).ToList();
        });
    }

    private async Task RotateAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var actor = state.User.Identity?.Name ?? "admin";

            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                var signingKeyService = sp.GetRequiredService<ISigningKeyService>();
                var audit = sp.GetRequiredService<IAuditService>();
                var result = await signingKeyService.RotateAsync();
                await audit.WriteAsync(new AuditWriteRequest
                {
                    Actor = actor,
                    Action = "signing_key.rotated",
                    EntityType = "SigningKey",
                    EntityId = result.NewKeyId,
                    Detail = $"previous={result.PreviousKeyId}"
                });
            });
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
