@page "/admin/signing-keys"
@attribute [Authorize(Policy = AuthPolicies.SuperAdminOnly)]
@rendermode InteractiveServer
@inject IServiceScopeFactory Scopes
@inject AuthenticationStateProvider AuthState

<div class="page-header">
    <div>
        <h1>Ключи подписи</h1>
        <div class="sub">
            Ed25519 ключи используются для подписи каталога серверов и билетов доступа. Это НЕ TLS-сертификаты.
            TLS находится в разделе Инфраструктура.
        </div>
    </div>
    <button class="btn" disabled="@(_busy || !_canRotate)" @onclick="() => _confirm = true">
        Безопасно сменить ключ
    </button>
</div>

@if (!string.IsNullOrEmpty(_info))
{
    <div class="alert">@_info</div>
}
@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-error">@_error</div>
}

@foreach (var k in _keys.Where(x => x.Status is "Current" or "Next" or "Retiring"))
{
    <div class="panel">
        <h3>@StatusTitle(k.Status)</h3>
        <p class="mono">@k.KeyId</p>
        <p class="muted">Создан: @k.CreatedAt.ToString("dd.MM.yyyy HH:mm 'UTC'")</p>
        @if (k.PromotedAt is not null)
        {
            <p class="muted">Продвинут: @k.PromotedAt?.ToString("dd.MM.yyyy HH:mm 'UTC'")</p>
        }
        @if (k.Status == "Current")
        {
            <p>Используется для подписи: да</p>
        }
        @if (k.Status == "Next")
        {
            <p class="muted">Статус: подготовлен · опубликован для проверки</p>
        }
        @if (k.Status == "Retiring" && k.RetireAfter is not null)
        {
            <p>Используется только для проверки</p>
            <p class="muted">Будет выведен: @k.RetireAfter?.ToString("dd.MM.yyyy HH:mm 'UTC'")</p>
        }
        <p class="muted mono">@Convert.ToHexString(k.PublicKey)</p>
    </div>
}

@if (_keys.Any(x => x.Status == "Retired"))
{
    <div class="panel">
        <h3>Выведенные из обращения</h3>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Ключ</th><th>Выведен</th></tr></thead>
                <tbody>
                @foreach (var k in _keys.Where(x => x.Status == "Retired").Take(20))
                {
                    <tr>
                        <td class="mono">@k.KeyId</td>
                        <td>@(k.RetiredAt?.ToString("dd.MM.yyyy HH:mm 'UTC'") ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<ConfirmDialog @bind-Visible="_confirm"
               Title="Безопасная смена ключа"
               Message="@_confirmMessage"
               ConfirmText="Сменить"
               OnConfirm="RotateAsync" />

@code {
    private List<SigningKeyAdminDto> _keys = new();
    private bool _confirm;
    private bool _busy;
    private bool _canRotate;
    private string _confirmMessage = "";
    private string? _error;
    private string? _info;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var svc = sp.GetRequiredService<ISigningKeyService>();
            _keys = (await svc.ListAllKeysForAdminAsync()).ToList();
            var retiring = _keys.FirstOrDefault(k => k.Status == "Retiring");
            var next = _keys.FirstOrDefault(k => k.Status == "Next");
            var current = _keys.FirstOrDefault(k => k.Status == "Current");
            _canRotate = retiring is null && next is not null;
            _confirmMessage =
                $"Сейчас: Current {(current?.KeyId ?? "—")}, Next {(next?.KeyId ?? "—")}. " +
                "После: текущий → Retiring (проверка до конца grace), Next → Current, будет создан новый Next. " +
                "Действующие каталоги и билеты, подписанные предыдущим ключом, продолжат проверяться до окончания grace period.";
            if (!_canRotate && retiring is not null)
                _info = "Ротация недоступна, пока активен ключ в статусе Retiring.";
            else if (!_canRotate)
                _info = "Следующий ключ ещё не готов.";
            else
                _info = null;
        });
    }

    private async Task RotateAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var actor = state.User.Identity?.Name ?? "admin";
            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                var signingKeyService = sp.GetRequiredService<ISigningKeyService>();
                var audit = sp.GetRequiredService<IAuditService>();
                var result = await signingKeyService.RotateAsync();
                await audit.WriteAsync(new AuditWriteRequest
                {
                    Actor = actor,
                    Action = "signing_key.rotated",
                    EntityType = "SigningKey",
                    EntityId = result.NewKeyId,
                    Detail = $"previous={result.PreviousKeyId}"
                });
            });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = UiText.Error(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string StatusTitle(string status) => status switch
    {
        "Current" => "Текущий ключ",
        "Next" => "Следующий ключ",
        "Retiring" => "Предыдущий ключ (завершает работу)",
        _ => status
    };
}
