@page "/"
@attribute [Authorize(Policy = AuthPolicies.AnyAdmin)]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IServiceScopeFactory Scopes
@inject NavigationManager Nav
@inject IConfiguration Configuration

@if (_needsSetup)
{
    <p class="muted">@_setupMessage</p>
}
else if (_summary is null)
{
    <p class="muted">Загрузка обзора…</p>
}
else
{
    <div class="page-header">
        <div>
            <h1>Обзор</h1>
            <div class="sub">Состояние системы · @DateTime.UtcNow.ToString("dd.MM.yyyy HH:mm:ss 'UTC'")</div>
        </div>
    </div>

    <AttentionPanel Items="_attention" />

    <p><a class="btn" href="/admin/metrics">Метрики и графики серверов</a></p>
    <div class="panel">
        <h3>Control Plane</h3>
        <p class="muted">Версия @_summary.ControlPlaneVersion · Узел @_summary.Hostname · URL @(_summary.PublicUrl.Length > 0 ? _summary.PublicUrl : "—") · Локальный порт @_summary.LocalPort · TLS @_summary.TlsStatus</p>
        <p class="muted">Сертификат: @_summary.CertificateHealth · Осталось дней: @(_summary.CertificateDaysRemaining?.ToString() ?? "—") · Issuer @(_summary.CertificateIssuer ?? "—")</p>
        <p class="muted">SAN: @(_summary.CertificateSan ?? "—") · Thumbprint @(_summary.CertificateThumbprint ?? "—") · Private key @(_summary.CertificatePrivateKeyPresent ? "да" : "нет") · ACL @_summary.CertificateServiceKeyAccess</p>
        <p class="muted">NotAfter: @(_summary.CertificateNotAfter?.ToString("dd.MM.yyyy HH:mm:ss 'UTC'") ?? "—") · Trust @_summary.CertificateTrustMode</p>
        <p class="muted">Текущий ключ: @(_summary.CurrentSigningKeyId ?? "—") · Следующий ключ: @(_summary.NextSigningKeyId ?? "—")</p>
    </div>
    @if (_summary.Warnings.Count > 0)
    {
        <div class="panel"><h3>Предупреждения</h3>
            @foreach (var warning in _summary.Warnings) { <div class="alert alert-error">@warning</div> }
        </div>
    }

    @if (_infra is not null)
    {
        <div class="panel">
            <h3>Certificates</h3>
            @if (_infraCritical)
            {
                <div class="alert alert-error">Есть сертификаты в критическом состоянии или истёкшие.</div>
            }
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Объект</th><th>Состояние</th><th>Осталось</th></tr></thead>
                    <tbody>
                    <tr>
                        <td>Control Plane</td>
                        <td>@_infra.ControlPlaneCertificate.Health</td>
                        <td>@(_infra.ControlPlaneCertificate.DaysRemaining?.ToString() ?? "—") дн.</td>
                    </tr>
                    @foreach (var n in _infra.Nodes)
                    {
                        <tr>
                            <td>@n.DisplayName</td>
                            <td>@n.Health</td>
                            <td>@(n.DaysRemaining?.ToString() ?? "—") дн.</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p style="margin-top:.75rem"><a href="/admin/infrastructure">Инфраструктура</a></p>
        </div>
    }

    <div class="stats-grid">
        <div class="stat"><a href="/admin/nodes"><div class="label">Всего серверов</div><div class="value">@_summary.TotalNodes</div></a></div>
        <div class="stat"><a href="/admin/nodes"><div class="label">Работают штатно</div><div class="value">@_summary.HealthyNodes</div></a></div>
        <div class="stat"><a href="/admin/nodes"><div class="label">Работают с ограничениями</div><div class="value">@_summary.DegradedNodes</div></a></div>
        <div class="stat"><a href="/admin/nodes"><div class="label">Не в сети</div><div class="value">@_summary.OfflineNodes</div></a></div>
        <div class="stat"><div class="label">Отключены</div><div class="value">@_summary.DisabledNodes</div></div>
        <div class="stat"><div class="label">Завершают сеансы</div><div class="value">@_summary.DrainingNodes</div></div>
        <div class="stat"><div class="label">Обслуживание</div><div class="value">@_summary.MaintenanceNodes</div></div>
        <div class="stat"><a href="/admin/infrastructure"><div class="label">Сертификаты истекают</div><div class="value">@_summary.CertificatesExpiring</div></a></div>
        <div class="stat"><a href="/admin/infrastructure"><div class="label">Сертификаты истекли</div><div class="value">@_summary.CertificatesExpired</div></a></div>
        <div class="stat"><a href="/admin/nodes"><div class="label">Нет связи &gt; 5 мин</div><div class="value">@_summary.StaleHeartbeatNodes</div></a></div>
        <div class="stat"><a href="/admin/operations"><div class="label">Устаревшая версия</div><div class="value">@_summary.OutdatedVersionNodes</div></a></div>
        <div class="stat"><div class="label">Активные сеансы</div><div class="value">@_summary.ActiveSessions</div></div>
        <div class="stat"><a href="/admin/licenses"><div class="label">Активные лицензии</div><div class="value">@_summary.ActiveLicenses</div></a></div>
        <div class="stat"><a href="/admin/licenses"><div class="label">Истекают за 14 дней</div><div class="value">@_summary.ExpiringLicenses</div></a></div>
        <div class="stat"><div class="label">Отозванные лицензии</div><div class="value">@_summary.RevokedLicenses</div></div>
        <div class="stat"><a href="/admin/devices"><div class="label">Активные устройства</div><div class="value">@_summary.ActiveDevices</div></a></div>
        <div class="stat"><a href="/admin/bootstrap-tokens"><div class="label">Активные токены регистрации</div><div class="value">@_summary.PendingBootstrapTokens</div></a></div>
    </div>
}

@code {
    private DashboardSummary? _summary;
    private InfrastructureOverviewDto? _infra;
    private IReadOnlyList<AttentionItem> _attention = Array.Empty<AttentionItem>();
    private bool _infraCritical;
    private bool _needsSetup;
    private string _setupMessage = "Переход к первоначальной настройке…";
    private readonly CancellationTokenSource _stop = new();
    private Task? _poll;
    private AdminRealtimeClient? _realtime;

    protected override async Task OnInitializedAsync()
    {
        var adminCount = await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var userManager = sp.GetRequiredService<UserManager<ApplicationUser>>();
            var admins = await userManager.GetUsersInRoleAsync(AdminRole.SuperAdmin);
            return admins.Count;
        });

        if (adminCount == 0)
        {
            _needsSetup = true;
            var setup = WebBootstrapGuard.ReadSetupOptions(Configuration);
            if (setup.AllowWebBootstrap)
            {
                Nav.NavigateTo("/setup", forceLoad: true);
            }
            else
            {
                _setupMessage = "Главный администратор не создан. Выполните команду установщика: admin create --username <email>";
            }
            return;
        }

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _needsSetup) return;
        _poll = PollAsync();
        _realtime = await AdminRealtimeClient.ConnectAsync(Nav, async () =>
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }, _stop.Token);
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
                await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
    }

    private async Task LoadAsync()
    {
        await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var dash = sp.GetRequiredService<IDashboardQueryService>();
            _summary = await dash.GetSummaryAsync();
            _attention = await dash.GetAttentionAsync();
            _infra = await sp.GetRequiredService<IInfrastructureOverviewService>().GetOverviewAsync();
            _infraCritical = _infra.ControlPlaneCertificate.Health is
                                 nameof(CertificateHealthStatus.Critical) or nameof(CertificateHealthStatus.Expired)
                             || _infra.Nodes.Any(n =>
                                 n.Health is nameof(CertificateHealthStatus.Critical) or nameof(CertificateHealthStatus.Expired));
        });
    }

    public async ValueTask DisposeAsync()
    {
        _stop.Cancel();
        if (_realtime is not null) await _realtime.DisposeAsync();
        if (_poll is not null) try { await _poll; } catch { /* ignore */ }
        _stop.Dispose();
    }
}
