@page "/admin/licenses"
@attribute [Authorize(Policy = AuthPolicies.AnyAdmin)]
@rendermode InteractiveServer
@inject IServiceScopeFactory Scopes
@inject AuthenticationStateProvider AuthState

<div class="page-header">
    <div>
        <h1>Лицензии</h1>
        <div class="sub">Создание, продление и отзыв лицензий. Ключи показываются только один раз.</div>
    </div>
    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
        <button class="btn" @onclick="() => _showCreate = !_showCreate" disabled="@_busy">@(_showCreate ? "Закрыть" : "Создать лицензию")</button>
    </AuthorizeView>
</div>

@if (!string.IsNullOrEmpty(_rawToken))
{
    <div class="alert alert-warn">
        <strong>Сохраните этот лицензионный ключ сейчас.</strong> Повторно он показан не будет.
        <div class="mono" style="margin-top:.5rem">@_rawToken</div>
        <button class="btn btn-ghost btn-sm" style="margin-top:.5rem" @onclick="() => _rawToken = null">Закрыть</button>
    </div>
}

@if (_showCreate)
{
    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
        <div class="panel">
            <div class="form-grid">
                <label>Тариф
                    <select @bind="_createPlanId">
                        @foreach (var p in _plans)
                        {
                            <option value="@p.PlanId">@p.Code — @p.Name</option>
                        }
                    </select>
                </label>
                <label>Роль
                    <select @bind="_createRole">
                        <option value="user">Пользователь</option>
                        <option value="master">Мастер</option>
                        <option value="test">Тестирование</option>
                    </select>
                </label>
                <label>Лимит устройств<input type="number" min="1" @bind="_createMaxDevices" /></label>
                <label>Истекает (UTC)<input type="datetime-local" @bind="_createExpiresLocal" /></label>
                <label>Разрешённые локации (коды через запятую)<input @bind="_createLocations" /></label>
                <label>Примечание<input @bind="_createNote" /></label>
            </div>
            <div class="actions" style="margin-top:1rem">
                <button class="btn" @onclick="CreateAsync" disabled="@_busy">Создать</button>
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-error" style="margin-top:1rem">@_error</div>
            }
        </div>
    </AuthorizeView>
}

<div class="toolbar">
    <input placeholder="Поиск по лицензии, роли или примечанию" @bind="_filter" @bind:event="oninput" />
    <select @bind="_statusFilter">
        <option value="">Все статусы</option>
        @foreach (var s in Enum.GetNames<LicenseStatus>())
        {
            <option value="@s">@UiText.Status(s)</option>
        }
    </select>
</div>

<div class="table-wrap">
    <table class="data">
        <thead>
            <tr>
                <th>Лицензия</th>
                <th>Тариф</th>
                <th>Роль</th>
                <th>Статус</th>
                <th>Создано (UTC)</th>
                <th>Истекает (UTC)</th>
                <th>Устройства</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Filtered())
            {
                <tr>
                    <td class="mono">@LicenseIdFormat.ToPublicId(row.License.LicenseId)</td>
                    <td>@row.PlanCode</td>
                    <td>@UiText.Role(row.License.Role)</td>
                    <td><StatusBadge Status="@row.License.Status.ToString()" /></td>
                    <td>@row.License.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss 'UTC'")</td>
                    <td>@(row.License.ExpiresAt?.ToString("dd.MM.yyyy HH:mm:ss 'UTC'") ?? "—")</td>
                    <td>@row.DeviceCount / @row.License.MaxDevices</td>
                    <td>
                        <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
                            <div class="actions">
                                <button class="btn btn-ghost btn-sm" @onclick="() => ExtendAsync(row.License.LicenseId)" disabled="@_busy">+30 дней</button>
                                @if (row.License.Status == LicenseStatus.Active)
                                {
                                    <button class="btn btn-ghost btn-sm" @onclick="() => AskRevoke(row.License.LicenseId)" disabled="@_busy">Отозвать</button>
                                }
                            </div>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<ConfirmDialog @bind-Visible="_confirmRevoke"
               Title="Отозвать лицензию"
               Message="Лицензия будет окончательно отозвана и добавлена в список отзывов."
               ConfirmText="Отозвать"
               OnConfirm="ConfirmRevokeAsync" />

@code {
    private sealed record Row(License License, string PlanCode, int DeviceCount);

    private List<Row> _rows = new();
    private List<Plan> _plans = new();
    private string _filter = "";
    private string _statusFilter = "";
    private bool _showCreate;
    private bool _busy;
    private string? _error;
    private string? _rawToken;
    private Guid _createPlanId;
    private string _createRole = "user";
    private int _createMaxDevices = 3;
    private DateTime? _createExpiresLocal;
    private string _createLocations = "";
    private string _createNote = "";
    private bool _confirmRevoke;
    private Guid _revokeId;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var db = sp.GetRequiredService<ControlPlaneDbContext>();
            _plans = await db.Plans.OrderBy(p => p.Code).ToListAsync();
            if (_plans.Count > 0 && _createPlanId == Guid.Empty)
            {
                _createPlanId = _plans[0].PlanId;
                _createMaxDevices = _plans[0].MaxDevices;
            }

            var licenses = await db.Licenses.Include(l => l.Plan).Include(l => l.Devices).OrderByDescending(l => l.CreatedAt).Take(500).ToListAsync();
            _rows = licenses.Select(l => new Row(l, l.Plan.Code, l.Devices.Count(d => d.Status == DeviceStatus.Active))).ToList();
        });
    }

    private IEnumerable<Row> Filtered()
    {
        IEnumerable<Row> q = _rows;
        if (!string.IsNullOrWhiteSpace(_statusFilter) && Enum.TryParse<LicenseStatus>(_statusFilter, out var st))
            q = q.Where(r => r.License.Status == st);
        if (!string.IsNullOrWhiteSpace(_filter))
        {
            var f = _filter.Trim();
            q = q.Where(r =>
                LicenseIdFormat.ToPublicId(r.License.LicenseId).Contains(f, StringComparison.OrdinalIgnoreCase) ||
                r.License.Role.Contains(f, StringComparison.OrdinalIgnoreCase) ||
                (r.License.Note?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
                r.PlanCode.Contains(f, StringComparison.OrdinalIgnoreCase));
        }
        return q;
    }

    private async Task CreateAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var actor = await ActorAsync();
            var locations = string.IsNullOrWhiteSpace(_createLocations)
                ? null
                : _createLocations.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

            DateTime? expires = null;
            if (_createExpiresLocal.HasValue)
                expires = DateTime.SpecifyKind(_createExpiresLocal.Value, DateTimeKind.Utc);

            var planId = _createPlanId;
            var role = _createRole;
            var maxDevices = _createMaxDevices;
            var note = string.IsNullOrWhiteSpace(_createNote) ? null : _createNote;

            var resp = await BlazorWork.RunAsync(Scopes, sp =>
            {
                var licenseService = sp.GetRequiredService<ILicenseProvisioningService>();
                return licenseService.CreateLicenseAsync(new CreateLicenseRequest
                {
                    PlanId = planId,
                    Role = role,
                    MaxDevices = maxDevices,
                    ExpiresAt = expires,
                    AllowedLocations = locations,
                    Note = note,
                    CreatedBy = actor
                });
            });
            _rawToken = resp.LicenseToken;
            _showCreate = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = UiText.Error(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExtendAsync(Guid id)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var actor = await ActorAsync();
            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                var db = sp.GetRequiredService<ControlPlaneDbContext>();
                var licenseService = sp.GetRequiredService<ILicenseProvisioningService>();
                var audit = sp.GetRequiredService<IAuditService>();

                var license = await db.Licenses.FirstAsync(l => l.LicenseId == id);
                var baseDate = license.ExpiresAt is { } e && e > DateTime.UtcNow ? e : DateTime.UtcNow;
                await licenseService.ExtendLicenseAsync(new ExtendLicenseRequest
                {
                    LicenseId = id,
                    ExpiresAt = baseDate.AddDays(30)
                });
                await audit.WriteAsync(new AuditWriteRequest
                {
                    Actor = actor,
                    Action = "license.extended",
                    EntityType = "License",
                    EntityId = LicenseIdFormat.ToPublicId(id),
                    Detail = "+30 days"
                });
            });
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void AskRevoke(Guid id)
    {
        if (_busy) return;
        _revokeId = id;
        _confirmRevoke = true;
    }

    private async Task ConfirmRevokeAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var revokeId = _revokeId;
            await BlazorWork.RunAsync(Scopes, sp =>
            {
                var licenseService = sp.GetRequiredService<ILicenseProvisioningService>();
                return licenseService.RevokeLicenseAsync(revokeId);
            });
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<string> ActorAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        return state.User.Identity?.Name ?? "admin";
    }
}
