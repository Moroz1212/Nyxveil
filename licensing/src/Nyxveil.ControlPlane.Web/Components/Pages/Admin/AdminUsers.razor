@page "/admin/admin-users"
@attribute [Authorize(Policy = AuthPolicies.SuperAdminOnly)]
@rendermode InteractiveServer
@inject IServiceScopeFactory Scopes
@inject AuthenticationStateProvider AuthState

<div class="page-header">
    <div>
        <h1>Администраторы</h1>
        <div class="sub">Учётные записи администраторов панели. Управление доступно только главному администратору.</div>
    </div>
    <button class="btn" @onclick="() => _showCreate = !_showCreate" disabled="@_busy">@(_showCreate ? "Закрыть" : "Добавить администратора")</button>
</div>

@if (_showCreate)
{
    <div class="panel form-grid">
        <label>Электронная почта<input @bind="_email" type="email" /></label>
        <label>Отображаемое имя<input @bind="_displayName" /></label>
        <label>Пароль<input @bind="_password" type="password" /></label>
        <label>Роль
            <select @bind="_role">
                <option value="@AdminRole.ReadOnly">Только просмотр</option>
                <option value="@AdminRole.Operator">Оператор</option>
                <option value="@AdminRole.SuperAdmin">Главный администратор</option>
            </select>
        </label>
        <div class="actions" style="align-self:end"><button class="btn" @onclick="CreateAsync" disabled="@_busy">Создать</button></div>
    </div>
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-error">@_error</div>
    }
}

<div class="table-wrap">
    <table class="data">
        <thead><tr><th>Электронная почта</th><th>Название</th><th>Роли</th></tr></thead>
        <tbody>
        @foreach (var row in _rows)
        {
            <tr>
                <td>@row.Email</td>
                <td>@(row.DisplayName ?? "—")</td>
                <td>@string.Join(", ", row.Roles.Select(UiText.Role))</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private sealed record Row(string Email, string? DisplayName, IReadOnlyList<string> Roles);

    private List<Row> _rows = new();
    private bool _showCreate;
    private bool _busy;
    private string _email = "";
    private string _displayName = "";
    private string _password = "";
    private string _role = AdminRole.Operator;
    private string? _error;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _rows = await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var userManager = sp.GetRequiredService<UserManager<ApplicationUser>>();
            var users = userManager.Users.ToList();
            var rows = new List<Row>();
            foreach (var u in users)
            {
                var roles = await userManager.GetRolesAsync(u);
                rows.Add(new Row(u.Email ?? u.UserName ?? u.Id, u.DisplayName, roles.ToList()));
            }
            return rows.OrderBy(r => r.Email).ToList();
        });
    }

    private async Task CreateAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var actor = state.User.Identity?.Name ?? "admin";
            var email = _email.Trim();
            var displayName = string.IsNullOrWhiteSpace(_displayName) ? null : _displayName.Trim();
            var password = _password;
            var role = _role;

            var error = await BlazorWork.RunAsync(Scopes, async sp =>
            {
                var userManager = sp.GetRequiredService<UserManager<ApplicationUser>>();
                var audit = sp.GetRequiredService<IAuditService>();
                var user = new ApplicationUser
                {
                    UserName = email,
                    Email = email,
                    EmailConfirmed = true,
                    DisplayName = displayName
                };
                var result = await userManager.CreateAsync(user, password);
                if (!result.Succeeded)
                    return string.Join("; ", result.Errors.Select(UiText.IdentityError));

                await userManager.AddToRoleAsync(user, role);
                await audit.WriteAsync(new AuditWriteRequest
                {
                    Actor = actor,
                    Action = "admin_user.created",
                    EntityType = "AdminUser",
                    EntityId = user.Id,
                    Detail = $"role={role}"
                });
                return null;
            });

            if (error is not null)
            {
                _error = error;
                return;
            }

            _showCreate = false;
            _password = "";
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
