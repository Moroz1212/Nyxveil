@page "/admin/nodes/{NodeId}"
@attribute [Authorize(Policy = AuthPolicies.AnyAdmin)]
@rendermode InteractiveServer
@inject IServiceScopeFactory Scopes
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IClock Clock
@inject IHttpContextAccessor HttpContextAccessor

@if (_notFound)
{
    <p class="muted">Сервер не найден.</p>
}
else if (_node is null)
{
    <p class="muted">Загрузка…</p>
}
else
{
    <div class="page-header">
        <div>
            <h1>@_node.DisplayName</h1>
            <div class="sub mono">@_node.NodeId · @_node.LocationId</div>
            <div class="sub">@UiText.OperatorMode(_mode) · <span class="freshness-hint">@_freshnessLabel</span></div>
        </div>
        <div class="actions">
            <button class="btn btn-ghost" disabled="@_busy" @onclick="LoadAsync">Обновить статус</button>
            <a class="btn" href="@($"/admin/metrics?node={Uri.EscapeDataString(NodeId)}")">Графики нагрузки</a>
            <a class="btn btn-ghost" href="/admin/nodes">Назад</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-error" role="alert">@_error</div>
    }
    @if (_stepUpNeeded)
    {
        <div class="alert alert-warn" role="status">
            Для этой операции нужна повторная проверка MFA.
            <a href="@StepUpUrl">Подтвердить код аутентификатора</a>
        </div>
    }
    @if (!string.IsNullOrEmpty(_cmdInfo))
    {
        <div class="alert" role="status">@_cmdInfo</div>
    }
    @if (_mode == OperatorNodeMode.Recovering)
    {
        <div class="alert alert-warn mode-recovering">Восстановление после обновления: runtime-флаги ещё не стабилизировались.</div>
    }

    <nav class="section-nav" aria-label="Разделы сервера">
        <a href="#sec-a">Обзор</a>
        <a href="#sec-b">Runtime</a>
        <a href="#sec-c">Сертификат</a>
        <a href="#sec-d">Версия</a>
        <a href="#sec-e">Управление</a>
        <a href="#sec-f">Адреса</a>
        <a href="#sec-g">История</a>
        <a href="#sec-h">Опасная зона</a>
    </nav>

    @* A. Overview *@
    <div class="stats-grid" id="sec-a">
        <div class="stat"><div class="label">Режим</div><div class="value" style="font-size:1.05rem">@UiText.OperatorMode(_mode)</div></div>
        <div class="stat"><div class="label">Сеансы</div><div class="value">@_node.CurrentSessions / @(_cfg?.Capacity ?? _node.Capacity)</div></div>
        <div class="stat"><div class="label">Версия конфигурации</div><div class="value" style="font-size:1rem">v@(_cfg?.ConfigVersion ?? _node.ConfigVersion)</div></div>
        <div class="stat"><div class="label">CPU</div><div class="value">@(_health?.CpuPercent.ToString("0.0", UiText.Culture) ?? "—")%</div></div>
        <div class="stat"><div class="label">Жизненный цикл</div><div class="value" style="font-size:1rem">@UiText.Lifecycle(_node.LifecycleState)</div></div>
    </div>

    @* B. Runtime health *@
    <div class="panel" id="sec-b">
        <h3>Runtime</h3>
        <p class="muted">Только флаги здоровья среды. Срок сертификата сюда не входит.</p>
        <div class="health-matrix" style="justify-content:flex-start; gap:1rem; margin:.75rem 0">
            <div class="col"><span>TUN</span><HealthDot State="@RuntimeHealthPresentation.FromNullable(_health?.TunReady)" Label="TUN" /></div>
            <div class="col"><span>TLS</span><HealthDot State="@RuntimeHealthPresentation.FromNullable(_health?.TlsOk)" Label="TLS runtime" /></div>
            <div class="col"><span>QUIC</span><HealthDot State="@RuntimeHealthPresentation.FromNullable(_health?.QuicOk)" Label="QUIC" /></div>
            <div class="col"><span>BRG</span><HealthDot State="@RuntimeHealthPresentation.FromNullable(_health?.BridgeOk)" Label="Bridge" /></div>
            <div class="col"><span>TKEY</span><HealthDot State="@RuntimeHealthPresentation.FromNullable(_health?.TicketKeysLoaded)" Label="Ticket keys" /></div>
            <div class="col"><span>CP</span><HealthDot State="@RuntimeHealthPresentation.FromNullable(_health?.CpConnected)" Label="CP" /></div>
        </div>
        <p class="muted">
            TUN=@UiText.RuntimeFlag(RuntimeHealthPresentation.FromNullable(_health?.TunReady)) ·
            TLS=@UiText.RuntimeFlag(RuntimeHealthPresentation.FromNullable(_health?.TlsOk)) ·
            QUIC=@UiText.RuntimeFlag(RuntimeHealthPresentation.FromNullable(_health?.QuicOk)) ·
            Bridge=@UiText.RuntimeFlag(RuntimeHealthPresentation.FromNullable(_health?.BridgeOk)) ·
            Ticket keys=@UiText.RuntimeFlag(RuntimeHealthPresentation.FromNullable(_health?.TicketKeysLoaded)) ·
            CP=@UiText.RuntimeFlag(RuntimeHealthPresentation.FromNullable(_health?.CpConnected))
        </p>
        <p class="muted">Remote management: @(_node.SupportsNodeCommands ? "поддерживается" : "не поддерживается этой версией node")</p>
    </div>

    @* C. Certificate *@
    <div class="panel" id="sec-c">
        <h3>Сертификат TLS</h3>
        @{
            var certHealth = CertificateExpiry.Evaluate(_node.CertNotAfter, DateTime.UtcNow);
            var daysLeft = CertificateExpiry.DaysRemaining(_node.CertNotAfter, DateTime.UtcNow);
        }
        <p>
            <StatusBadge Status="@certHealth.ToString()" />
            · Осталось: @(daysLeft?.ToString() ?? "—") дн.
        </p>
        <p class="muted">TLS mode: @(_node.TlsMode ?? "—")</p>
        <p class="muted">Subject: @(_node.CertSubject ?? "—")</p>
        <p class="muted">Issuer: @(_node.CertIssuer ?? "—")</p>
        <p class="muted">SAN: @(_node.CertSan ?? "—")</p>
        <p class="muted">NotBefore: @(_node.CertNotBefore?.ToString("dd.MM.yyyy HH:mm:ss 'UTC'") ?? "—")</p>
        <p class="muted">NotAfter: @(_node.CertNotAfter?.ToString("dd.MM.yyyy HH:mm:ss 'UTC'") ?? "—")</p>
        <p class="muted">Thumbprint: @(_node.CertThumbprint ?? "—")</p>
        <p class="muted">ACME auto renew: @(_node.AcmeAutoRenew ? "включён" : "выключен")</p>
        <p class="muted">Last renewal attempt: @(_node.LastRenewalAttempt?.ToString("dd.MM.yyyy HH:mm:ss 'UTC'") ?? "—")</p>
        <p class="muted">Last successful renewal: @(_node.LastSuccessfulRenewal?.ToString("dd.MM.yyyy HH:mm:ss 'UTC'") ?? "—")</p>
        <p class="muted">Next planned renewal: @(_node.NextPlannedRenewal?.ToString("dd.MM.yyyy HH:mm:ss 'UTC'") ?? "—")</p>
        @if (!string.IsNullOrWhiteSpace(_node.LastRenewalError))
        {
            <div class="alert alert-error">Ошибка обновления сертификата: @_node.LastRenewalError</div>
        }
        @if (_node.SupportsNodeCommands)
        {
            <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
                <div class="actions" style="margin-top:.75rem">
                    <button class="btn" disabled="@(_busy || !NodeCommandCapabilities.Supports(_node, NodeCommandType.RenewCertificate))" @onclick="() => EnqueueAsync(NodeCommandType.RenewCertificate)">Обновить сертификат сейчас</button>
                </div>
            </AuthorizeView>
        }
    </div>

    @* D. Version / update *@
    <div class="panel" id="sec-d">
        <h3>Версия сервера</h3>
        @{
            var installed = NodeVersionEvaluator.EffectiveInstalledVersion(_node.ReportedServerVersion, _node.ServerVersion);
            var hasUpdateCap = NodeCommandCapabilities.Supports(_node, NodeCommandType.UpdateNodeLatest);
        }
        <p>Установлено: <strong>@(installed ?? "—")</strong></p>
        <p class="muted">Последний отчёт: @(_node.VersionReportedAt?.ToString("dd.MM.yyyy HH:mm 'UTC'") ?? "—")</p>
        <p class="muted">Актуальная: @(_latestVersion ?? "—") · GitHub: @(_latestTag ?? "—")</p>
        <p>Статус: <strong>@NodeVersionEvaluator.DisplayRu(NodeVersionEvaluator.Evaluate(installed, _latestVersion, _minSupported))</strong></p>
        <AuthorizeView Policy="@AuthPolicies.SuperAdminOnly">
            @if (hasUpdateCap && _node.SupportsNodeCommands)
            {
                var st = NodeVersionEvaluator.Evaluate(installed, _latestVersion, _minSupported);
                @if (st is NodeVersionStatus.UpdateAvailable or NodeVersionStatus.Unsupported)
                {
                    <button class="btn" disabled="@_busy" @onclick="PrepareUpdateAsync">Обновить до @(_latestVersion ?? "latest")</button>
                }
                else if (st == NodeVersionStatus.Current)
                {
                    <button class="btn" disabled="true">Актуальная версия</button>
                }
            }
            else if (_node.SupportsNodeCommands)
            {
                <p class="muted">Удалённое обновление не поддерживается этой версией.</p>
            }
        </AuthorizeView>
        @if (_node.SupportsNodeCommands)
        {
            <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
                <div class="actions" style="margin-top:.75rem">
                    <button class="btn btn-ghost" disabled="@(_busy || !NodeCommandCapabilities.Supports(_node, NodeCommandType.RestartNyxveilService))" @onclick="() => EnqueueAsync(NodeCommandType.RestartNyxveilService)">Перезапустить Nyxveil</button>
                </div>
            </AuthorizeView>
        }
    </div>

    @* E. Management / config *@
    <div class="panel" id="sec-e">
        <h3>Конфигурация и управление</h3>
        @if (_cfg is not null)
        {
            <p class="muted">
                Включён=@(_cfg.Enabled ? "да" : "нет") ·
                Завершение сеансов=@(_cfg.Draining ? "да" : "нет") ·
                Обслуживание=@(_cfg.MaintenanceMode ? "да" : "нет") ·
                Тестовый=@(_node.TestOnly ? "да" : "нет") ·
                Лимит=@_cfg.Capacity
            </p>
        }
        <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
            <div class="actions">
                <button class="btn btn-ghost" @onclick="() => SetEnabledAsync(!(_cfg?.Enabled ?? true))" disabled="@_busy">@((_cfg?.Enabled ?? true) ? "Отключить" : "Включить")</button>
                <button class="btn btn-ghost" @onclick="() => SetDrainingAsync(!(_cfg?.Draining ?? false))" disabled="@_busy">@((_cfg?.Draining ?? false) ? "Разрешить новые сеансы" : "Завершать текущие сеансы")</button>
                <button class="btn btn-ghost" @onclick="() => SetTestOnlyAsync(!_node.TestOnly)" disabled="@_busy">@(_node.TestOnly ? "Снять тестовый режим" : "Включить тестовый режим")</button>
                @if (_cfg?.MaintenanceMode == true)
                {
                    <button class="btn btn-ghost" @onclick="ExitMaintenanceAsync" disabled="@_busy">Завершить обслуживание</button>
                }
                else
                {
                    <button class="btn btn-danger" @onclick="() => _confirmMaint = true" disabled="@_busy">Начать обслуживание</button>
                }
            </div>
            <div class="form-grid" style="margin-top:1rem">
                <label>Лимит одновременных сеансов
                    <input type="number" min="0" @bind="_editCapacity" />
                </label>
                <label>Локация (идентификатор или код)
                    <input @bind="_editLocation" />
                </label>
            </div>
            <div class="actions" style="margin-top:.75rem">
                <button class="btn" @onclick="SaveCapacityAsync" disabled="@_busy">Сохранить лимит</button>
                <button class="btn btn-ghost" @onclick="ChangeLocationAsync" disabled="@_busy">Изменить локацию</button>
            </div>
        </AuthorizeView>
    </div>

    @* F. Endpoints *@
    <div class="panel" id="sec-f">
        <h3>Идентификация и адреса подключения</h3>
        <p class="mono muted">Открытый ключ идентификации: @Convert.ToHexString(_node.PublicIdentity)</p>
        <p class="muted">Протокол @_node.ProtocolVersion · Версия сервера @(_node.ServerVersion ?? "—") · SPKI @(_node.SpkiPin is null ? "—" : Convert.ToHexString(_node.SpkiPin))</p>
        <div class="table-wrap" style="margin-top:.75rem">
            <table class="data">
                <thead><tr><th>Адрес</th><th>Порт</th><th>Семейство адресов</th><th>Приоритет</th><th>Включено</th></tr></thead>
                <tbody>
                @foreach (var ep in _endpoints)
                {
                    <tr>
                        <td>@ep.Host</td>
                        <td>@ep.Port</td>
                        <td>@ep.AddressFamily</td>
                        <td>@ep.Priority</td>
                        <td>@(ep.Enabled ? "да" : "нет")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @* G. History *@
    <div class="panel" id="sec-g">
        <h3>История операций</h3>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Время (UTC)</th>
                        <th>Операция</th>
                        <th>Кем</th>
                        <th>Статус</th>
                        <th>Результат</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in _commands)
                {
                    <tr>
                        <td>@c.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@UiText.CommandType(c.Type)</td>
                        <td>@c.CreatedBy</td>
                        <td><StatusBadge Status="@c.Status.ToString()" /> @c.ProgressPhase</td>
                        <td class="muted">@c.PreviousVersion → @c.TargetVersion<br />@UiText.ResultCode(c.ResultCode)<br />@(c.ResultMessage ?? c.ProgressMessage ?? "Ожидание выполнения")</td>
                        <td>
                            <AuthorizeView Policy="@AuthPolicies.SuperAdminOnly">
                                @if (NodeCommandService.IsUnknownUpdateOutcomeEligible(c))
                                {
                                    <button class="btn btn-ghost" disabled="@_busy" @onclick="() => PrepareReconcileAsync(c.Id)">Разрешить неопределённый результат</button>
                                }
                            </AuthorizeView>
                        </td>
                    </tr>
                    @if (c.Type == NodeCommandType.UpdateNodeLatest)
                    {
                        <tr>
                            <td colspan="6"><UpdateTimeline Steps="@UpdateCommandTimeline.Build(c)" /></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <h3 style="margin-top:1.25rem">Последние метрики</h3>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Время (UTC)</th><th>CPU</th><th>Память</th><th>Сеансы</th></tr></thead>
                <tbody>
                @foreach (var m in _metrics)
                {
                    <tr>
                        <td>@m.Timestamp.ToString("dd.MM.yyyy HH:mm:ss 'UTC'")</td>
                        <td>@m.CpuPercent.ToString("0.0", UiText.Culture)%</td>
                        <td>@m.MemoryPercent.ToString("0.0", UiText.Culture)%</td>
                        <td>@m.ActiveSessions</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @* H. Danger zone *@
    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove" Context="dangerAuth">
        <div class="panel danger-zone" id="sec-h">
            <h3>Опасная зона</h3>
            <p class="muted">Удаление и перезагрузка требуют ввода подтверждения.</p>
            <div class="actions">
                @if (_node.LifecycleState != NodeLifecycleState.Deleted)
                {
                    <button class="btn btn-danger" @onclick="PrepareDeleteAsync" disabled="@_busy">Удалить сервер</button>
                }
                <AuthorizeView Policy="@AuthPolicies.SuperAdminOnly" Context="rebootAuth">
                    @if (_node.SupportsNodeCommands)
                    {
                        <button class="btn btn-danger" disabled="@_busy" @onclick="PrepareReboot">Перезагрузить сервер</button>
                    }
                </AuthorizeView>
            </div>
        </div>
    </AuthorizeView>
}

<ConfirmDialog @bind-Visible="_confirmMaint"
               Title="Начать обслуживание"
               Message="Перевести сервер в режим обслуживания? Новые подключения не будут направляться на этот сервер. Сохранённые настройки доступности и завершения сеансов сохранятся."
               ConfirmText="Подтвердить"
               OnConfirm="EnterMaintenanceAsync" />
<ConfirmDialog @bind-Visible="_confirmDelete"
               Title="Удалить сервер"
               Message="@(_deletePreview?.ImpactSummary ?? "Загрузка влияния…")"
               RequiredConfirmation="@DeleteConfirmation"
               ConfirmText="Удалить"
               OnConfirm="DeleteAsync" />

@if (_confirmReboot)
{
    <div class="modal-backdrop" @onclick="() => _confirmReboot = false">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Перезагрузить сервер</h3>
            <p>@_rebootMessage</p>
            <label>Введите имя сервера или <strong>REBOOT @DeleteConfirmation</strong>
                <input @bind="_rebootTyped" autocomplete="off" />
            </label>
            <div class="actions">
                <button type="button" class="btn btn-ghost" @onclick="() => _confirmReboot = false">Отмена</button>
                <button type="button" class="btn btn-danger" disabled="@(!CanConfirmReboot)" @onclick="ConfirmRebootAsync">Перезагрузить</button>
            </div>
        </div>
    </div>
}

<UpdatePreflightDialog @bind-Visible="_confirmUpdate"
                       Result="_preflight"
                       Busy="_busy"
                       StepUpRequired="@StepUpGuard.RequiresStepUp(HttpContextAccessor.HttpContext)"
                       StepUpUrl="@StepUpUrl"
                       OnConfirm="ConfirmUpdateAsync" />

@if (_reconcileVisible && _reconcilePreview is not null)
{
    <div class="modal-backdrop" @onclick="CloseReconcile">
        <div class="modal" @onclick:stopPropagation="true" style="max-width:36rem">
            <h3>Разрешить неопределённый результат обновления</h3>
            <p class="muted">Только SuperAdmin. Location lock снимается только после подтверждённого evidence-based outcome.</p>
            <p><strong>Node:</strong> @_reconcilePreview.NodeId</p>
            <p><strong>Command:</strong> @_reconcilePreview.CommandId.ToString("N")</p>
            <p><strong>Previous → Target:</strong> @_reconcilePreview.PreviousVersion → @_reconcilePreview.TargetVersion</p>
            <p><strong>Observed:</strong> @(_reconcilePreview.ObservedVersion ?? "—")</p>
            <p><strong>Last heartbeat:</strong> @(_reconcilePreview.LastSeenAt?.ToString("dd.MM.yyyy HH:mm:ss 'UTC'") ?? "—") · fresh=@(_reconcilePreview.HeartbeatFresh ? "yes" : "no")</p>
            <p><strong>Status:</strong> @_reconcilePreview.Status / @_reconcilePreview.ResultCode</p>
            <p><strong>Draining:</strong> @_reconcilePreview.Draining · Sessions: @_reconcilePreview.CurrentSessions · Enabled: @_reconcilePreview.Enabled</p>
            @if (!string.IsNullOrWhiteSpace(_reconcilePreview.BlockingReason) && !_reconcilePreview.CanConfirmRollback && !_reconcilePreview.CanConfirmUpdated)
            {
                <div class="alert alert-error">@_reconcilePreview.BlockingReason</div>
            }
            <label>Причина / комментарий оператора
                <textarea @bind="_reconcileReason" rows="3" style="width:100%"></textarea>
            </label>
            <div class="actions" style="margin-top:.75rem">
                <button type="button" class="btn btn-ghost" @onclick="CloseReconcile">Отмена</button>
                @if (_reconcilePreview.CanConfirmRollback)
                {
                    <button type="button" class="btn" disabled="@(_busy || string.IsNullOrWhiteSpace(_reconcileReason))"
                            @onclick="() => ConfirmReconcileAsync(UnknownUpdateReconciliationAction.ConfirmRollback)">
                        Подтвердить откат
                    </button>
                }
                @if (_reconcilePreview.CanConfirmUpdated)
                {
                    <button type="button" class="btn" disabled="@(_busy || string.IsNullOrWhiteSpace(_reconcileReason))"
                            @onclick="() => ConfirmReconcileAsync(UnknownUpdateReconciliationAction.ConfirmUpdated)">
                        Подтвердить успешное обновление
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string NodeId { get; set; } = "";

    private Node? _node;
    private NodeConfig? _cfg;
    private NodeHealth? _health;
    private List<NodeEndpoint> _endpoints = new();
    private List<NodeMetric> _metrics = new();
    private List<NodeCommand> _commands = new();
    private bool _notFound;
    private bool _confirmMaint;
    private bool _confirmDelete;
    private bool _confirmReboot;
    private bool _confirmUpdate;
    private bool _reconcileVisible;
    private bool _stepUpNeeded;
    private UnknownUpdateReconciliationPreview? _reconcilePreview;
    private UpdatePreflightResult? _preflight;
    private string _reconcileReason = "";
    private string _rebootMessage = "";
    private string _rebootTyped = "";
    private string? _latestVersion;
    private string? _latestTag;
    private string? _minSupported;
    private NodeDecommissionPreview? _deletePreview;
    private bool _busy;
    private int _editCapacity;
    private string _editLocation = "";
    private string? _error;
    private string? _cmdInfo;
    private OperatorNodeMode _mode;
    private string _freshnessLabel = "";
    private string DeleteConfirmation => string.IsNullOrWhiteSpace(_node?.DisplayName) ? NodeId : _node.DisplayName;
    private string StepUpUrl =>
        $"/account/mfa/step-up?returnUrl={Uri.EscapeDataString($"/admin/nodes/{NodeId}")}";
    private bool CanConfirmReboot
    {
        get
        {
            var typed = _rebootTyped.Trim();
            return string.Equals(typed, DeleteConfirmation, StringComparison.Ordinal)
                   || string.Equals(typed, $"REBOOT {DeleteConfirmation}", StringComparison.Ordinal);
        }
    }

    private bool EnsureStepUp()
    {
        if (!StepUpGuard.RequiresStepUp(HttpContextAccessor.HttpContext))
        {
            _stepUpNeeded = false;
            return true;
        }

        _stepUpNeeded = true;
        _error = "Требуется повторная проверка MFA (step-up).";
        return false;
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        _notFound = false;
        await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var db = sp.GetRequiredService<ControlPlaneDbContext>();
            _node = await db.Nodes.AsNoTracking().FirstOrDefaultAsync(n => n.NodeId == NodeId);
            if (_node is null || _node.LifecycleState == NodeLifecycleState.Deleted)
            {
                _node = null;
                _notFound = true;
                return;
            }
            _cfg = await db.NodeConfigs.AsNoTracking().FirstOrDefaultAsync(c => c.NodeId == NodeId);
            _health = await db.NodeHealth.AsNoTracking().FirstOrDefaultAsync(h => h.NodeId == NodeId);
            _endpoints = await db.NodeEndpoints.AsNoTracking().Where(e => e.NodeId == NodeId).OrderBy(e => e.Priority).ToListAsync();
            _metrics = await db.NodeMetrics.AsNoTracking().Where(m => m.NodeId == NodeId).OrderByDescending(m => m.Timestamp).Take(50).ToListAsync();
            _commands = (await sp.GetRequiredService<INodeCommandService>().ListForNodeAsync(NodeId, 20)).ToList();
            _editCapacity = _cfg?.Capacity ?? _node.Capacity;
            _editLocation = _node.LocationId;
            var release = await sp.GetRequiredService<IServerReleaseService>().GetLatestAsync();
            _latestVersion = release.LatestVersion;
            _latestTag = release.ReleaseTag;
            _minSupported = sp.GetRequiredService<Microsoft.Extensions.Options.IOptions<ServerReleasePolicyOptions>>()
                .Value.MinimumSupportedVersion;

            var now = Clock.UtcNow;
            var recentUpdate = _commands.FirstOrDefault(c =>
                c.Type == NodeCommandType.UpdateNodeLatest
                && c.Status == NodeCommandStatus.Succeeded
                && string.Equals(c.ResultCode, "updated_healthy", StringComparison.OrdinalIgnoreCase)
                && c.CompletedAt is not null
                && c.CompletedAt > now.AddMinutes(-10));
            _mode = RuntimeHealthPresentation.EvaluateMode(
                _node, _health, _cfg, now, recentSuccessfulUpdate: recentUpdate is not null);
            var seen = _node.LastSeenAt ?? _health?.UpdatedAt;
            _freshnessLabel = NodeFreshness.LabelRu(NodeFreshness.Evaluate(seen, now), NodeFreshness.Age(seen, now));
        });
    }

    private async Task<string> ActorAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        return state.User.Identity?.Name ?? "admin";
    }

    private async Task EnqueueAsync(NodeCommandType type)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        _cmdInfo = null;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var actor = state.User.Identity?.Name ?? "admin";
            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                var um = sp.GetRequiredService<UserManager<ApplicationUser>>();
                var user = await um.GetUserAsync(state.User);
                var roles = user is null ? Array.Empty<string>() : await um.GetRolesAsync(user);
                await sp.GetRequiredService<INodeCommandService>()
                    .EnqueueAsync(NodeId, type, actor, roles);
            });
            _cmdInfo = type switch
            {
                NodeCommandType.RenewCertificate => "Команда отправлена → ожидание node → обновление сертификата…",
                NodeCommandType.RestartNyxveilService => "Перезапуск… ожидание сервера…",
                NodeCommandType.UpdateNodeLatest => "Обновление поставлено в очередь.",
                NodeCommandType.RebootHost => "Перезагрузка поставлена в очередь.",
                _ => "Команда отправлена."
            };
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = UiText.Error(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private void PrepareReboot()
    {
        if (_node is null) return;
        var sessionsWarn = _node.CurrentSessions > 0
            ? $" На сервере активно {_node.CurrentSessions} соединений. Они будут разорваны."
            : "";
        _rebootMessage =
            $"Перезагрузить ОС сервера {_node.DisplayName} ({_node.NodeId})?{sessionsWarn}";
        _rebootTyped = "";
        _confirmReboot = true;
    }

    private async Task PrepareUpdateAsync()
    {
        _error = null;
        _preflight = null;
        try
        {
            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                var preflight = sp.GetService<IUpdatePreflightService>();
                if (preflight is null)
                {
                    _error = "Сервис preflight недоступен.";
                    return;
                }
                _preflight = await preflight.EvaluateUpdateAsync(NodeId);
            });
            if (_preflight is not null)
                _confirmUpdate = true;
        }
        catch (Exception ex)
        {
            _error = UiText.Error(ex.Message);
        }
    }

    private async Task ConfirmRebootAsync()
    {
        if (!CanConfirmReboot) return;
        if (!EnsureStepUp()) return;
        _confirmReboot = false;
        await EnqueueAsync(NodeCommandType.RebootHost);
    }

    private async Task ConfirmUpdateAsync()
    {
        // Keep preflight open when step-up expired; modal shows MFA CTA (do not silently close).
        if (StepUpGuard.RequiresStepUp(HttpContextAccessor.HttpContext))
        {
            _stepUpNeeded = true;
            _error = null;
            return;
        }

        _confirmUpdate = false;
        await EnqueueAsync(NodeCommandType.UpdateNodeLatest);
    }

    private async Task PrepareReconcileAsync(Guid commandId)
    {
        _error = null;
        _reconcileReason = "";
        _reconcilePreview = null;
        try
        {
            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                _reconcilePreview = await sp.GetRequiredService<INodeCommandService>()
                    .GetUnknownUpdateReconciliationPreviewAsync(commandId, NodeId);
            });
            _reconcileVisible = _reconcilePreview is not null;
        }
        catch (Exception ex)
        {
            _error = UiText.Error(ex.Message);
        }
    }

    private void CloseReconcile()
    {
        _reconcileVisible = false;
        _reconcilePreview = null;
        _reconcileReason = "";
    }

    private async Task ConfirmReconcileAsync(UnknownUpdateReconciliationAction action)
    {
        if (_busy || _reconcilePreview is null || string.IsNullOrWhiteSpace(_reconcileReason))
            return;
        if (!EnsureStepUp()) return;
        _busy = true;
        _error = null;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var actor = state.User.Identity?.Name ?? "admin";
            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                var um = sp.GetRequiredService<UserManager<ApplicationUser>>();
                var user = await um.GetUserAsync(state.User);
                var roles = user is null ? Array.Empty<string>() : await um.GetRolesAsync(user);
                await sp.GetRequiredService<INodeCommandService>().ReconcileUnknownUpdateAsync(
                    new UnknownUpdateReconciliationRequest
                    {
                        CommandId = _reconcilePreview.CommandId,
                        NodeId = NodeId,
                        Action = action,
                        Actor = actor,
                        Roles = roles.ToList(),
                        Reason = _reconcileReason.Trim()
                    });
            });
            _cmdInfo = action == UnknownUpdateReconciliationAction.ConfirmRollback
                ? "Неопределённый результат разрешён как откат; admin state восстановлен."
                : "Неопределённый результат разрешён как успешное обновление.";
            CloseReconcile();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = UiText.Error(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunNodeActionAsync(Func<INodeManagementService, string, Task> action)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var actor = await ActorAsync();
            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                var nodeMgmt = sp.GetRequiredService<INodeManagementService>();
                await action(nodeMgmt, actor);
            });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = UiText.Error(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task SetEnabledAsync(bool enabled) =>
        RunNodeActionAsync((svc, actor) => svc.SetEnabledAsync(NodeId, enabled, actor));

    private Task SetDrainingAsync(bool draining) =>
        RunNodeActionAsync((svc, actor) => svc.SetDrainingAsync(NodeId, draining, actor));

    private Task SetTestOnlyAsync(bool testOnly) =>
        RunNodeActionAsync((svc, actor) => svc.SetTestOnlyAsync(NodeId, testOnly, actor));

    private Task EnterMaintenanceAsync() =>
        RunNodeActionAsync((svc, actor) => svc.EnterMaintenanceAsync(NodeId, actor));

    private Task ExitMaintenanceAsync() =>
        RunNodeActionAsync((svc, actor) => svc.ExitMaintenanceAsync(NodeId, actor));

    private Task SaveCapacityAsync() =>
        RunNodeActionAsync((svc, actor) => svc.SetCapacityAsync(NodeId, _editCapacity, actor));

    private Task ChangeLocationAsync() =>
        RunNodeActionAsync((svc, actor) => svc.ChangeLocationAsync(NodeId, _editLocation, actor));

    private async Task PrepareDeleteAsync()
    {
        _deletePreview = await BlazorWork.RunAsync(Scopes, sp =>
            sp.GetRequiredService<INodeManagementService>().GetDecommissionPreviewAsync(NodeId));
        _confirmDelete = true;
    }

    private async Task DeleteAsync()
    {
        if (!EnsureStepUp()) return;
        await RunNodeActionAsync((svc, actor) => svc.SoftDeleteAsync(NodeId, actor, "Deleted from admin panel"));
        if (_notFound || _node is null)
            Nav.NavigateTo("/admin/nodes");
    }
}
