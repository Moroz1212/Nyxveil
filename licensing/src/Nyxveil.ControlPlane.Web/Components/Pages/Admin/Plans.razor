@page "/admin/plans"
@attribute [Authorize(Policy = AuthPolicies.AnyAdmin)]
@rendermode InteractiveServer
@inject ControlPlaneDbContext Db
@inject IClock Clock
@inject AuthenticationStateProvider AuthState
@inject IAuditService Audit

<div class="page-header">
    <div>
        <h1>Plans</h1>
        <div class="sub">Subscription plans (trial / standard / premium / master).</div>
    </div>
    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
        <button class="btn" @onclick="() => _showCreate = !_showCreate">@(_showCreate ? "Close" : "Add plan")</button>
    </AuthorizeView>
</div>

@if (_showCreate)
{
    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
        <div class="panel form-grid">
            <label>Code<input @bind="_code" /></label>
            <label>Name<input @bind="_name" /></label>
            <label>Duration days<input type="number" min="0" @bind="_duration" /></label>
            <label>Max devices<input type="number" min="1" @bind="_maxDevices" /></label>
            <label>Locations policy<input @bind="_locationsPolicy" /></label>
            <label>Permissions JSON<input @bind="_permissions" /></label>
            <div class="actions" style="align-self:end"><button class="btn" @onclick="CreateAsync">Save</button></div>
        </div>
    </AuthorizeView>
}

<div class="table-wrap">
    <table class="data">
        <thead><tr><th>Code</th><th>Name</th><th>Status</th><th>Days</th><th>Max devices</th><th>Permissions</th></tr></thead>
        <tbody>
        @foreach (var p in _plans)
        {
            <tr>
                <td>@p.Code</td>
                <td>@p.Name</td>
                <td><StatusBadge Status="@p.Status" /></td>
                <td>@p.DurationDays</td>
                <td>@p.MaxDevices</td>
                <td class="mono">@p.Permissions</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private List<Plan> _plans = new();
    private bool _showCreate;
    private string _code = "";
    private string _name = "";
    private int _duration = 30;
    private int _maxDevices = 3;
    private string _locationsPolicy = "[\"*\"]";
    private string _permissions = "[\"connect\"]";

    protected override async Task OnInitializedAsync() =>
        _plans = await Db.Plans.OrderBy(p => p.Code).ToListAsync();

    private async Task CreateAsync()
    {
        var now = Clock.UtcNow;
        var plan = new Plan
        {
            PlanId = Guid.NewGuid(),
            Code = _code.Trim(),
            Name = _name.Trim(),
            Status = "Active",
            DurationDays = _duration,
            MaxDevices = Math.Max(1, _maxDevices),
            AllowedLocationsPolicy = _locationsPolicy,
            Permissions = _permissions,
            CreatedAt = now,
            UpdatedAt = now
        };
        Db.Plans.Add(plan);
        await Db.SaveChangesAsync();
        var state = await AuthState.GetAuthenticationStateAsync();
        await Audit.WriteAsync(new AuditWriteRequest
        {
            Actor = state.User.Identity?.Name ?? "admin",
            Action = "plan.created",
            EntityType = "Plan",
            EntityId = plan.PlanId.ToString()
        });
        _showCreate = false;
        _plans = await Db.Plans.OrderBy(p => p.Code).ToListAsync();
    }
}
