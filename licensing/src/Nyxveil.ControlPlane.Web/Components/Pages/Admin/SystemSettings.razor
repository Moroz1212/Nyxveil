@page "/admin/settings"
@attribute [Authorize(Policy = AuthPolicies.AnyAdmin)]
@rendermode InteractiveServer
@inject IServiceScopeFactory Scopes
@inject IClock Clock
@inject AuthenticationStateProvider AuthState

<div class="page-header">
    <div>
        <h1>Настройки системы</h1>
        <div class="sub">Рабочие настройки в формате «ключ — значение», без секретов.</div>
    </div>
    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
        <button class="btn" @onclick="() => _showCreate = !_showCreate" disabled="@_busy">@(_showCreate ? "Закрыть" : "Добавить настройку")</button>
    </AuthorizeView>
</div>

@if (_showCreate)
{
    <AuthorizeView Policy="@AuthPolicies.OperatorOrAbove">
        <div class="panel form-grid">
            <label>Ключ<input @bind="_key" /></label>
            <label>Значение<input @bind="_value" /></label>
            <div class="actions" style="align-self:end"><button class="btn" @onclick="SaveAsync" disabled="@_busy">Сохранить</button></div>
        </div>
    </AuthorizeView>
}

<div class="table-wrap">
    <table class="data">
        <thead><tr><th>Ключ</th><th>Значение</th><th>Обновлено (UTC)</th><th>Автор</th></tr></thead>
        <tbody>
        @foreach (var s in _settings)
        {
            <tr>
                <td class="mono">@s.Key</td>
                <td class="mono">@s.Value</td>
                <td>@s.UpdatedAt.ToString("dd.MM.yyyy HH:mm:ss 'UTC'")</td>
                <td>@(s.UpdatedBy ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private List<SystemSetting> _settings = new();
    private bool _showCreate;
    private bool _busy;
    private string _key = "";
    private string _value = "";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _settings = await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var db = sp.GetRequiredService<ControlPlaneDbContext>();
            return await db.SystemSettings.OrderBy(s => s.Key).ToListAsync();
        });
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var actor = state.User.Identity?.Name ?? "admin";
            var key = _key.Trim();
            var value = _value;
            var now = Clock.UtcNow;

            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                var db = sp.GetRequiredService<ControlPlaneDbContext>();
                var audit = sp.GetRequiredService<IAuditService>();
                var existing = await db.SystemSettings.FirstOrDefaultAsync(s => s.Key == key);
                if (existing is null)
                {
                    db.SystemSettings.Add(new SystemSetting
                    {
                        Key = key,
                        Value = value,
                        UpdatedAt = now,
                        UpdatedBy = actor
                    });
                }
                else
                {
                    existing.Value = value;
                    existing.UpdatedAt = now;
                    existing.UpdatedBy = actor;
                }

                await db.SaveChangesAsync();
                await audit.WriteAsync(new AuditWriteRequest
                {
                    Actor = actor,
                    Action = "system_setting.upsert",
                    EntityType = "SystemSetting",
                    EntityId = key
                });
            });
            _showCreate = false;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
