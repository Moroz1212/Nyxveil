@page "/admin/operations"
@attribute [Authorize(Policy = AuthPolicies.AnyAdmin)]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IServiceScopeFactory Scopes
@inject AuthenticationStateProvider AuthState
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav

<PageTitle>Обновления и операции · Nyxveil</PageTitle>
<div class="page-header">
    <div><div class="eyebrow">Инфраструктура</div><h1>Обновления и операции</h1>
        <div class="sub">Принятие команды, ход и результат — в одном журнале. Время UTC. Удалённые серверы скрыты.</div></div>
    <button class="btn btn-ghost" disabled="@_busy" @onclick="RefreshAsync">Обновить статус</button>
</div>
@if (_error is not null) { <div class="alert alert-error" role="alert">@_error</div> }
@if (_stepUpNeeded)
{
    <div class="alert alert-warn" role="status">
        Для reconciliation нужна повторная проверка MFA.
        <a href="@StepUpUrl">Подтвердить код аутентификатора</a>
    </div>
}
@if (_info is not null) { <div class="alert" role="status">@_info</div> }
<div class="operations-intro">
    <section class="panel">
        <div class="eyebrow">Стабильный выпуск сервера</div>
        <h2>@(_release?.LatestVersion ?? "Версия не подтверждена")</h2>
        <p class="muted">@_release?.ReleaseTag · источник: @(_release?.SourceStatus ?? "проверка")</p>
        @if (_release?.ErrorMessage is not null) { <p class="alert alert-error">@_release.ErrorMessage</p> }
        <p class="muted">Целевая версия фиксируется при постановке команды. Откат отображается как неудачное обновление.</p>
        <AuthorizeView Policy="@AuthPolicies.SuperAdminOnly">
            <button class="btn" disabled="@_busy" @onclick="RefreshReleaseAsync">Проверить GitHub Releases</button>
        </AuthorizeView>
    </section>
    <section class="operations-guide">
        <h2>Управление по локациям</h2>
        <p>Для обновления откройте карточку VPN-сервера. В его локации должен оставаться другой здоровый сервер со свободной ёмкостью.</p>
        <p class="muted">Во время обновления новые подключения направляются на доступные серверы. Неопределённый результат требует диагностики через reconciliation SuperAdmin.</p>
        <div class="actions"><a class="btn btn-ghost" href="/admin/nodes">Выбрать сервер</a><a class="btn btn-ghost" href="/admin/infrastructure">Сертификаты</a></div>
    </section>
</div>
<div class="toolbar">
    <label>Поиск<input @bind="_query" @bind:event="oninput" placeholder="CommandId, CorrelationId, сервер…" /></label>
    <label>Статус
        <select @bind="_statusFilter">
            <option value="">Все</option>
            @foreach (var s in Enum.GetNames<NodeCommandStatus>()) { <option value="@s">@UiText.Status(s)</option> }
        </select>
    </label>
    <label>Тип
        <select @bind="_typeFilter">
            <option value="">Все</option>
            @foreach (var t in Enum.GetValues<NodeCommandType>()) { <option value="@t">@UiText.CommandType(t)</option> }
        </select>
    </label>
    <label>Быстрый фильтр
        <select @bind="_quick">
            <option value="all">Все</option>
            <option value="active">Active</option>
            <option value="failed">Failed</option>
            <option value="unknown">Unknown</option>
            <option value="successful">Successful</option>
            <option value="update">Update</option>
        </select>
    </label>
    <label>Узел<input @bind="_nodeFilter" @bind:event="oninput" placeholder="NodeId" /></label>
    <label>Локация<input @bind="_locationFilter" @bind:event="oninput" placeholder="LocationId" /></label>
    <span class="muted">Страница @_page · по @_pageSize · всего @_total</span>
</div>

@foreach (var row in _rows)
{
    var command = row.Command;
    <details class="panel command-card">
        <summary>
            <span>@command.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</span>
            <a href="@($"/admin/nodes/{Uri.EscapeDataString(command.NodeId)}")">@(row.DisplayName)</a>
            <span class="muted">@row.LocationId</span>
            <span>@UiText.CommandType(command.Type)</span>
            <StatusBadge Status="@command.Status.ToString()" />
            <span class="muted">@UiText.ResultCode(command.ResultCode)</span>
        </summary>
        <p class="mono muted">CommandId @command.Id.ToString("N") · Correlation @command.CorrelationId.ToString("N")</p>
        <p class="muted">@command.PreviousVersion → @command.TargetVersion · phase @command.ProgressPhase</p>
        <p class="muted">@(command.ResultMessage ?? command.ProgressMessage ?? "Ожидание Node")</p>
        @if (command.Type == NodeCommandType.UpdateNodeLatest)
        {
            <UpdateTimeline Steps="@UpdateCommandTimeline.Build(command)" />
        }
        <AuthorizeView Policy="@AuthPolicies.SuperAdminOnly">
            @if (NodeCommandService.IsUnknownUpdateOutcomeEligible(command))
            {
                <button class="btn btn-ghost" disabled="@_busy" @onclick="() => PrepareReconcileAsync(command)">Разрешить неопределённый результат</button>
            }
        </AuthorizeView>
    </details>
}
@if (!_busy && _rows.Count == 0) { <p class="muted">Операций по выбранному фильтру нет.</p> }
<div class="pagination">
    <button class="btn btn-ghost" disabled="@(_page <= 1 || _busy)" @onclick="() => ChangePageAsync(-1)">Назад</button>
    <button class="btn btn-ghost" disabled="@(_page * _pageSize >= _total || _busy)" @onclick="() => ChangePageAsync(1)">Вперёд</button>
</div>

@if (_reconcileVisible && _reconcilePreview is not null)
{
    <div class="modal-backdrop" @onclick="CloseReconcile">
        <div class="modal" @onclick:stopPropagation="true" style="max-width:36rem">
            <h3>Разрешить неопределённый результат обновления</h3>
            <p class="muted">Только SuperAdmin. Location lock снимается только после подтверждённого evidence-based outcome.</p>
            <p><strong>Node:</strong> @_reconcilePreview.NodeId</p>
            <p><strong>Command:</strong> @_reconcilePreview.CommandId.ToString("N")</p>
            <p><strong>Previous → Target:</strong> @_reconcilePreview.PreviousVersion → @_reconcilePreview.TargetVersion</p>
            <p><strong>Observed:</strong> @(_reconcilePreview.ObservedVersion ?? "—")</p>
            <p><strong>Last heartbeat:</strong> @(_reconcilePreview.LastSeenAt?.ToString("dd.MM.yyyy HH:mm:ss 'UTC'") ?? "—") · fresh=@(_reconcilePreview.HeartbeatFresh ? "yes" : "no")</p>
            <p><strong>Status:</strong> @_reconcilePreview.Status / @_reconcilePreview.ResultCode</p>
            <p><strong>Draining:</strong> @_reconcilePreview.Draining · Sessions: @_reconcilePreview.CurrentSessions · Enabled: @_reconcilePreview.Enabled</p>
            @if (!string.IsNullOrWhiteSpace(_reconcilePreview.BlockingReason) && !_reconcilePreview.CanConfirmRollback && !_reconcilePreview.CanConfirmUpdated)
            {
                <div class="alert alert-error">@_reconcilePreview.BlockingReason</div>
            }
            <label>Причина / комментарий оператора
                <textarea @bind="_reconcileReason" rows="3" style="width:100%"></textarea>
            </label>
            <div class="actions" style="margin-top:.75rem">
                <button type="button" class="btn btn-ghost" @onclick="CloseReconcile">Отмена</button>
                @if (_reconcilePreview.CanConfirmRollback)
                {
                    <button type="button" class="btn" disabled="@(_busy || string.IsNullOrWhiteSpace(_reconcileReason))"
                            @onclick="() => ConfirmReconcileAsync(UnknownUpdateReconciliationAction.ConfirmRollback)">
                        Подтвердить откат
                    </button>
                }
                @if (_reconcilePreview.CanConfirmUpdated)
                {
                    <button type="button" class="btn" disabled="@(_busy || string.IsNullOrWhiteSpace(_reconcileReason))"
                            @onclick="() => ConfirmReconcileAsync(UnknownUpdateReconciliationAction.ConfirmUpdated)">
                        Подтвердить успешное обновление
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private sealed record CommandRow(NodeCommand Command, string DisplayName, string LocationId);

    private static readonly HashSet<string> UnknownCodes = new(StringComparer.OrdinalIgnoreCase)
    {
        "expired_outcome_unknown", "outcome_unknown", "rollback_failed"
    };

    private readonly CancellationTokenSource _stop = new();
    private Task? _poll;
    private List<CommandRow> _rows = new();
    private ServerReleaseInfo? _release;
    private string _query = "", _quick = "all", _statusFilter = "", _typeFilter = "", _nodeFilter = "", _locationFilter = "";
    private int _page = 1, _pageSize = 50, _total;
    private string? _error;
    private string? _info;
    private bool _busy;
    private bool _reconcileVisible;
    private bool _stepUpNeeded;
    private UnknownUpdateReconciliationPreview? _reconcilePreview;
    private string _reconcileReason = "";
    private string StepUpUrl =>
        $"/account/mfa/step-up?returnUrl={Uri.EscapeDataString("/admin/operations")}";

    private bool EnsureStepUp()
    {
        if (!StepUpGuard.RequiresStepUp(HttpContextAccessor.HttpContext))
        {
            _stepUpNeeded = false;
            return true;
        }

        _stepUpNeeded = true;
        _error = "Требуется повторная проверка MFA (step-up).";
        return false;
    }

    protected override async Task OnInitializedAsync() => await RefreshAsync();
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _poll = PollAsync();
        return Task.CompletedTask;
    }
    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try { while (await timer.WaitForNextTickAsync(_stop.Token)) await InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); }); }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
    }
    private Task RefreshAsync() => LoadAsync(false);
    private Task RefreshReleaseAsync() => LoadAsync(true);

    private async Task ChangePageAsync(int delta)
    {
        _page = Math.Max(1, _page + delta);
        await LoadAsync(false);
    }

    private async Task LoadAsync(bool refreshRelease)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                var db = sp.GetRequiredService<ControlPlaneDbContext>();
                var q = from c in db.NodeCommands.AsNoTracking()
                        join n in db.Nodes.AsNoTracking() on c.NodeId equals n.NodeId
                        where n.LifecycleState != NodeLifecycleState.Deleted
                        select new { Command = c, n.DisplayName, n.LocationId };

                if (!string.IsNullOrWhiteSpace(_statusFilter) && Enum.TryParse<NodeCommandStatus>(_statusFilter, out var st))
                    q = q.Where(x => x.Command.Status == st);
                if (!string.IsNullOrWhiteSpace(_typeFilter) && Enum.TryParse<NodeCommandType>(_typeFilter, out var tp))
                    q = q.Where(x => x.Command.Type == tp);
                if (!string.IsNullOrWhiteSpace(_nodeFilter))
                {
                    var nf = _nodeFilter.Trim();
                    q = q.Where(x => x.Command.NodeId.Contains(nf));
                }
                if (!string.IsNullOrWhiteSpace(_locationFilter))
                {
                    var lf = _locationFilter.Trim();
                    q = q.Where(x => x.LocationId.Contains(lf));
                }
                q = _quick switch
                {
                    "active" => q.Where(x => x.Command.CompletedAt == null),
                    "failed" => q.Where(x => x.Command.Status == NodeCommandStatus.Failed || x.Command.Status == NodeCommandStatus.Expired),
                    "unknown" => q.Where(x => x.Command.ResultCode != null && UnknownCodes.Contains(x.Command.ResultCode)),
                    "successful" => q.Where(x => x.Command.Status == NodeCommandStatus.Succeeded),
                    "update" => q.Where(x => x.Command.Type == NodeCommandType.UpdateNodeLatest),
                    _ => q
                };
                if (!string.IsNullOrWhiteSpace(_query))
                {
                    var f = _query.Trim();
                    if (Guid.TryParse(f, out var gid) || Guid.TryParseExact(f, "N", out gid))
                    {
                        q = q.Where(x => x.Command.Id == gid || x.Command.CorrelationId == gid);
                    }
                    else
                    {
                        q = q.Where(x =>
                            x.Command.NodeId.Contains(f) ||
                            (x.Command.ResultCode != null && x.Command.ResultCode.Contains(f)) ||
                            (x.Command.TargetVersion != null && x.Command.TargetVersion.Contains(f)) ||
                            x.DisplayName.Contains(f));
                    }
                }

                _total = await q.CountAsync(_stop.Token);
                var skip = (_page - 1) * _pageSize;
                if (skip >= _total && _page > 1)
                {
                    _page = 1;
                    skip = 0;
                }
                var page = await q.OrderByDescending(x => x.Command.CreatedAt)
                    .Skip(skip).Take(_pageSize).ToListAsync(_stop.Token);
                _rows = page.Select(x => new CommandRow(x.Command, string.IsNullOrWhiteSpace(x.DisplayName) ? x.Command.NodeId : x.DisplayName, x.LocationId)).ToList();

                var releases = sp.GetRequiredService<IServerReleaseService>();
                _release = refreshRelease ? await releases.RefreshAsync(_stop.Token) : await releases.GetLatestAsync(_stop.Token);
            });
            _error = null;
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
        catch (Exception ex) { _error = UiText.Error(ex.Message); }
        finally { _busy = false; }
    }

    private async Task PrepareReconcileAsync(NodeCommand command)
    {
        _error = null;
        _info = null;
        _reconcileReason = "";
        _reconcilePreview = null;
        try
        {
            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                _reconcilePreview = await sp.GetRequiredService<INodeCommandService>()
                    .GetUnknownUpdateReconciliationPreviewAsync(command.Id, command.NodeId);
            });
            _reconcileVisible = _reconcilePreview is not null;
        }
        catch (Exception ex)
        {
            _error = UiText.Error(ex.Message);
        }
    }

    private void CloseReconcile()
    {
        _reconcileVisible = false;
        _reconcilePreview = null;
        _reconcileReason = "";
    }

    private async Task ConfirmReconcileAsync(UnknownUpdateReconciliationAction action)
    {
        if (_busy || _reconcilePreview is null || string.IsNullOrWhiteSpace(_reconcileReason))
            return;
        if (!EnsureStepUp()) return;
        _busy = true;
        _error = null;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var actor = state.User.Identity?.Name ?? "admin";
            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                var um = sp.GetRequiredService<UserManager<ApplicationUser>>();
                var user = await um.GetUserAsync(state.User);
                var roles = user is null ? Array.Empty<string>() : await um.GetRolesAsync(user);
                await sp.GetRequiredService<INodeCommandService>().ReconcileUnknownUpdateAsync(
                    new UnknownUpdateReconciliationRequest
                    {
                        CommandId = _reconcilePreview.CommandId,
                        NodeId = _reconcilePreview.NodeId,
                        Action = action,
                        Actor = actor,
                        Roles = roles.ToList(),
                        Reason = _reconcileReason.Trim()
                    });
            });
            _info = action == UnknownUpdateReconciliationAction.ConfirmRollback
                ? "Неопределённый результат разрешён как откат."
                : "Неопределённый результат разрешён как успешное обновление.";
            CloseReconcile();
            await LoadAsync(false);
        }
        catch (Exception ex)
        {
            _error = UiText.Error(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _stop.Cancel();
        if (_poll is not null) await _poll;
        _stop.Dispose();
    }
}
