@page "/admin/control-plane"
@attribute [Authorize(Policy = AuthPolicies.SuperAdminOnly)]
@rendermode InteractiveServer
@inject IServiceScopeFactory Scopes
@inject AuthenticationStateProvider AuthState
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav
@using Nyxveil.ControlPlane.Application.SelfUpdate

<div class="page-header">
    <div>
        <h1>Control Plane</h1>
        <div class="sub">Самообновление из GitHub Releases · только SuperAdmin + MFA step-up</div>
    </div>
</div>

@if (_stepUpNeeded)
{
    <div class="alert alert-warn">
        Для обновления Control Plane нужна повторная проверка MFA.
        <a href="@StepUpUrl">Повысить привилегии</a>
    </div>
}

@if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-error">@_error</div> }
@if (!string.IsNullOrEmpty(_info)) { <div class="alert">@_info</div> }

@if (_status is null)
{
    <p class="muted">Загрузка…</p>
}
else
{
    <div class="panel">
        <h3>Версия</h3>
        <p>Installed: <strong class="mono">@_status.InstalledVersion</strong></p>
        <p>Latest stable: <strong class="mono">@(_status.LatestStableVersion ?? "—")</strong></p>
        <p>Status: <strong>@_status.StatusLabelRu</strong></p>
        <p class="muted">Release: @(_status.ReleaseTag ?? "—") · Published: @(_status.PublishedAt?.ToString("u") ?? "—")</p>
        <p class="muted">Package verification: @_status.PackageVerification · SHA256: <span class="mono">@(_status.PackageSha256 ?? "—")</span></p>
        <div class="actions">
            <button class="btn btn-ghost" @onclick="CheckAsync" disabled="@_busy">Проверить обновления</button>
            <button class="btn" data-testid="control-plane-update" disabled="@(_busy || !_status.CanUpdate)" @onclick="PrepareUpdateAsync">
                @(_status.Availability == ControlPlaneUpdateAvailability.Current ? "Актуальная версия" : $"Обновить до {_status.LatestStableVersion}")
            </button>
        </div>
        @if (!string.IsNullOrEmpty(_status.BlockReason))
        {
            <p class="muted">@_status.BlockReason</p>
        }
    </div>

    @if (_preflight is not null && _confirm)
    {
        <div class="panel">
            <h3>Pre-flight</h3>
            <ul>
                <li>Installed → Target: @_preflight.InstalledVersion → @_preflight.TargetVersion</li>
                <li>Tag: @_preflight.ReleaseTag</li>
                <li>SHA256: <span class="mono">@(_preflight.PackageSha256 ?? "—")</span></li>
                <li>Schema: @_preflight.SchemaVersion / expected @_preflight.ExpectedSchema</li>
                <li>Service: @_preflight.ServiceState</li>
                <li>InstallDir: <span class="mono">@(_preflight.InstallDirectory ?? "—")</span></li>
                <li>DB: @(_preflight.DatabaseConnected ? "OK" : "FAIL")</li>
                <li>Free disk: @_preflight.FreeDiskBytes bytes</li>
            </ul>
            @if (_preflight.BlockingReasons.Count > 0)
            {
                <div class="alert alert-error">@string.Join("; ", _preflight.BlockingReasons)</div>
            }
            <div class="actions">
                <button class="btn btn-ghost" @onclick="() => _confirm = false">Отмена</button>
                <button class="btn" disabled="@(_busy || !_preflight.Allowed)" @onclick="ConfirmUpdateAsync">Подтвердить обновление</button>
            </div>
        </div>
    }

    @if (_status.ActiveTransaction is not null)
    {
        <div class="panel">
            <h3>Транзакция @_status.ActiveTransaction.TransactionId.ToString("N")[..8]</h3>
            <p>@_status.ActiveTransaction.CurrentVersion → @_status.ActiveTransaction.TargetVersion · @_status.ActiveTransaction.Phase · @_status.ActiveTransaction.ProgressMessage</p>
            <ul>
                @foreach (var e in _status.ActiveTransaction.Timeline)
                {
                    <li>@(e.Ok ? "✓" : "●") @e.Phase — @e.Message</li>
                }
            </ul>
            <p class="muted">Страница может временно отключиться при перезапуске службы — это ожидаемо.</p>
        </div>
    }

    <div class="panel">
        <h3>История обновлений</h3>
        @if (_status.History.Count == 0)
        {
            <p class="muted">Пока нет завершённых транзакций.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Time</th><th>From</th><th>To</th><th>Actor</th><th>Result</th><th>SHA</th></tr></thead>
                    <tbody>
                    @foreach (var h in _status.History)
                    {
                        <tr>
                            <td>@h.CreatedAt.ToString("u")</td>
                            <td class="mono">@h.CurrentVersion</td>
                            <td class="mono">@h.TargetVersion</td>
                            <td>@h.RequestedBy</td>
                            <td>@(h.ResultCode ?? h.Status.ToString())</td>
                            <td class="mono">@(h.PackageSha256 is { Length: > 12 } ? h.PackageSha256[..12] + "…" : h.PackageSha256)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private ControlPlaneUpdateStatusDto? _status;
    private ControlPlaneUpdatePreflightDto? _preflight;
    private bool _busy;
    private bool _confirm;
    private bool _stepUpNeeded;
    private string? _error;
    private string? _info;

    private string StepUpUrl =>
        $"/account/mfa/step-up?returnUrl={Uri.EscapeDataString("/admin/control-plane")}";

    private bool EnsureStepUp()
    {
        if (!StepUpGuard.RequiresStepUp(HttpContextAccessor.HttpContext))
        {
            _stepUpNeeded = false;
            return true;
        }
        _stepUpNeeded = true;
        _error = "Требуется повторная проверка MFA (step-up).";
        return false;
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _status = await BlazorWork.RunAsync(Scopes, sp =>
            sp.GetRequiredService<IControlPlaneSelfUpdateService>().GetStatusAsync());
    }

    private async Task CheckAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                await sp.GetRequiredService<IControlPlaneReleaseService>().RefreshAsync();
                var audit = sp.GetRequiredService<IAuditService>();
                var state = await AuthState.GetAuthenticationStateAsync();
                await audit.WriteAsync(new AuditWriteRequest
                {
                    Actor = state.User.Identity?.Name ?? "admin",
                    Action = "controlplane.update.check",
                    EntityType = "ControlPlane",
                    EntityId = "self"
                });
            });
            await ReloadAsync();
            _info = "Проверка релизов выполнена.";
        }
        catch (Exception ex) { _error = UiText.Error(ex.Message); }
        finally { _busy = false; }
    }

    private async Task PrepareUpdateAsync()
    {
        _error = null;
        if (!EnsureStepUp()) return;
        _busy = true;
        try
        {
            _preflight = await BlazorWork.RunAsync(Scopes, sp =>
                sp.GetRequiredService<IControlPlaneSelfUpdateService>().EvaluatePreflightAsync());
            _confirm = true;
        }
        catch (Exception ex) { _error = UiText.Error(ex.Message); }
        finally { _busy = false; }
    }

    private async Task ConfirmUpdateAsync()
    {
        if (!EnsureStepUp()) return;
        _busy = true;
        _error = null;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var actor = state.User.Identity?.Name ?? "admin";
            await BlazorWork.RunAsync(Scopes, async sp =>
            {
                var um = sp.GetRequiredService<UserManager<ApplicationUser>>();
                var user = await um.GetUserAsync(state.User);
                var roles = user is null ? Array.Empty<string>() : await um.GetRolesAsync(user);
                await sp.GetRequiredService<IControlPlaneSelfUpdateService>()
                    .StartUpdateAsync(actor, roles);
            });
            _confirm = false;
            _info = "Обновление авторизовано. Updater принимает управление; страница может переподключиться.";
            await ReloadAsync();
        }
        catch (Exception ex) { _error = UiText.Error(ex.Message); }
        finally { _busy = false; }
    }
}
