@page "/setup"
@layout EmptyLayout
@inject IServiceScopeFactory Scopes
@inject NavigationManager Nav
@inject IConfiguration Configuration
@inject IHostEnvironment Environment
@inject IHttpContextAccessor HttpContextAccessor

<div class="auth-page">
    <div class="auth-card">
        <h1>Первоначальная настройка</h1>

        @if (_showInstallerOnly)
        {
            <p class="muted">Создание администратора через сайт отключено. Используйте команду установщика:</p>
            <pre class="mono">Nyxveil.ControlPlane.Web.exe admin create --username admin@example.com</pre>
            <p class="muted">Установщик запросит пароль отдельно. Не указывайте пароль в аргументах команды.</p>
            <a href="/account/login">Перейти ко входу</a>
        }
        else if (_notFound)
        {
            <div class="alert alert-warn">Первоначальная настройка недоступна.</div>
            <a href="/account/login">Перейти ко входу</a>
        }
        else
        {
            <p class="muted">Создайте первого главного администратора. Эта форма доступна только при разрешённой первоначальной настройке.</p>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-error">@_error</div>
            }

            @if (_locked)
            {
                <div class="alert alert-warn">Настройка уже выполнена. Перейдите на страницу входа.</div>
                <a href="/account/login">Перейти ко входу</a>
            }
            else
            {
                <form method="post" action="/account/setup">
                    <label>Электронная почта<input name="email" type="email" required autocomplete="username" /></label>
                    <label>Отображаемое имя<input name="displayName" type="text" autocomplete="name" /></label>
                    <label>Пароль<input name="password" type="password" required minlength="12" autocomplete="new-password" /></label>
                    @if (_requireToken)
                    {
                        <label>Токен регистрации<input name="bootstrapToken" type="password" required autocomplete="one-time-code" /></label>
                    }
                    <button class="btn" type="submit">Создать главного администратора</button>
                </form>
            }
        }
    </div>
</div>

@code {
    private bool _locked;
    private bool _showInstallerOnly;
    private bool _notFound;
    private bool _requireToken;
    private string? _error;

    [SupplyParameterFromQuery] public string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _error = Error;
        var setup = WebBootstrapGuard.ReadSetupOptions(Configuration);
        var adminCount = await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var userManager = sp.GetRequiredService<UserManager<ApplicationUser>>();
            var admins = await userManager.GetUsersInRoleAsync(AdminRole.SuperAdmin);
            return admins.Count;
        });
        _locked = adminCount > 0;

        if (_locked)
        {
            Nav.NavigateTo("/account/login");
            return;
        }

        if (!setup.AllowWebBootstrap)
        {
            _showInstallerOnly = true;
            return;
        }

        var http = HttpContextAccessor.HttpContext;
        if (http is null)
        {
            _notFound = true;
            return;
        }

        // Page itself: Development convenience or Production localhost gate (token checked on POST).
        if (!Environment.IsDevelopment() && !WebBootstrapGuard.IsLocalhost(http))
        {
            _notFound = true;
            return;
        }

        _requireToken = !Environment.IsDevelopment();
    }
}
