@page "/account/login"
@layout EmptyLayout
@inject IServiceScopeFactory Scopes
@inject NavigationManager Nav
@inject IConfiguration Configuration

<div class="auth-page">
    <div class="auth-card">
        <h1>Войти</h1>
        <p class="muted">Панель управления Nyxveil</p>

        @if (_needsSetup)
        {
            @if (_allowWebBootstrap)
            {
                <div class="alert alert-warn">Главный администратор ещё не создан. <a href="/setup">Выполнить первоначальную настройку</a>.</div>
            }
            else
            {
                <div class="alert alert-warn">
                    Главный администратор ещё не создан. Выполните команду установщика:
                    <span class="mono">admin create --username &lt;email&gt;</span>
                </div>
            }
        }
        else
        {
            @if (_error)
            {
                <div class="alert alert-error">Неверная почта или пароль.</div>
            }
            @if (_setupOk)
            {
                <div class="alert alert-ok">Главный администратор создан. Войдите, чтобы продолжить.</div>
            }

            <form method="post" action="/account/login">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <label>Электронная почта<input name="email" type="email" required autocomplete="username" /></label>
                <label>Пароль<input name="password" type="password" required autocomplete="current-password" /></label>
                <button class="btn" type="submit">Войти</button>
            </form>
        }
    </div>
</div>

@code {
    private bool _needsSetup;
    private bool _allowWebBootstrap;
    private bool _error;
    private bool _setupOk;

    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; } = "/";
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "setup")] public string? Setup { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _error = Error == "1";
        _setupOk = Setup == "1";
        var setup = WebBootstrapGuard.ReadSetupOptions(Configuration);
        _allowWebBootstrap = setup.AllowWebBootstrap;

        var adminCount = await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var userManager = sp.GetRequiredService<UserManager<ApplicationUser>>();
            var admins = await userManager.GetUsersInRoleAsync(AdminRole.SuperAdmin);
            return admins.Count;
        });
        _needsSetup = adminCount == 0;
        if (_needsSetup && _allowWebBootstrap)
        {
            Nav.NavigateTo("/setup");
        }
    }
}
