@page "/account/mfa/setup"
@layout EmptyLayout
@attribute [Authorize(Policy = AuthPolicies.AnyAdmin)]
@inject IServiceScopeFactory Scopes
@inject NavigationManager Nav
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthState

<div class="auth-page">
    <div class="auth-card">
        <h1>Настройка MFA</h1>
        @if (_required)
        {
            <div class="alert alert-warn">Для главного администратора двухфакторная аутентификация обязательна.</div>
        }
        <p class="muted">Добавьте секрет в приложение-аутентификатор (Google Authenticator, Microsoft Authenticator и т.п.), затем подтвердите код.</p>

        @if (_error is not null)
        {
            <div class="alert alert-error">@_error</div>
        }

        @if (_recoveryCodes is { Length: > 0 })
        {
            <div class="alert alert-ok">MFA включена. Сохраните коды восстановления — они показываются только один раз.</div>
            <ul class="mono">
                @foreach (var recovery in _recoveryCodes)
                {
                    <li>@recovery</li>
                }
            </ul>
            <p><a class="btn" href="@(_returnUrl ?? "/account/mfa")">Продолжить</a></p>
        }
        else if (_sharedKey is not null)
        {
            <label>Общий ключ
                <input class="mono" type="text" readonly value="@_sharedKey" />
            </label>
            <label>URI otpauth
                <textarea class="mono" rows="3" readonly>@_otpAuthUri</textarea>
            </label>

            <form method="post" action="/account/mfa/setup">
                <input type="hidden" name="returnUrl" value="@(_returnUrl ?? "/")" />
                <input type="hidden" name="required" value="@(_required ? "1" : "0")" />
                <label>Код подтверждения
                    <input name="code" type="text" inputmode="numeric" autocomplete="one-time-code" required placeholder="123456" />
                </label>
                <button class="btn" type="submit">Включить MFA</button>
            </form>
        }
        else
        {
            <p class="muted">Загрузка…</p>
        }

        <p class="muted"><a href="/account/mfa">Статус MFA</a> · <a href="/account/logout">Выйти</a></p>
    </div>
</div>

@code {
    private bool _required;
    private string? _error;
    private string? _sharedKey;
    private string? _otpAuthUri;
    private string? _returnUrl;
    private string[]? _recoveryCodes;

    [SupplyParameterFromQuery(Name = "required")] public string? Required { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "showCodes")] public string? ShowCodes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _required = Required == "1";
        _returnUrl = string.IsNullOrWhiteSpace(ReturnUrl) || !ReturnUrl.StartsWith('/')
            ? "/"
            : ReturnUrl;
        if (Error == "1")
            _error = "Неверный код подтверждения.";
        else if (!string.IsNullOrEmpty(Error) && Error != "1")
            _error = Uri.UnescapeDataString(Error);

        if (!string.IsNullOrWhiteSpace(ShowCodes))
        {
            _recoveryCodes = await BlazorWork.RunAsync(Scopes, sp =>
            {
                var cache = sp.GetRequiredService<Microsoft.Extensions.Caching.Memory.IMemoryCache>();
                if (cache.TryGetValue($"mfa-recovery:{ShowCodes}", out object? boxed)
                    && boxed is string[] codes
                    && codes.Length > 0)
                {
                    cache.Remove($"mfa-recovery:{ShowCodes}");
                    return Task.FromResult<string[]?>(codes);
                }
                return Task.FromResult<string[]?>(null);
            });
            if (_recoveryCodes is null)
                _error = "Коды восстановления уже были показаны или истекли.";
            return;
        }

        var state = await AuthState.GetAuthenticationStateAsync();
        var email = state.User.Identity?.Name ?? "admin";
        var hosting = Configuration.GetSection(HostingOptions.SectionName).Get<HostingOptions>() ?? new HostingOptions();
        var issuer = string.IsNullOrWhiteSpace(hosting.PublicHostname) ? "Nyxveil" : $"Nyxveil ({hosting.PublicHostname})";

        await BlazorWork.RunAsync(Scopes, async sp =>
        {
            var userManager = sp.GetRequiredService<UserManager<ApplicationUser>>();
            var user = await userManager.GetUserAsync(state.User);
            if (user is null)
            {
                _error = "Пользователь не найден.";
                return;
            }

            var key = await userManager.GetAuthenticatorKeyAsync(user);
            if (string.IsNullOrEmpty(key))
            {
                await userManager.ResetAuthenticatorKeyAsync(user);
                key = await userManager.GetAuthenticatorKeyAsync(user);
            }

            if (string.IsNullOrEmpty(key))
            {
                _error = "Не удалось создать ключ аутентификатора.";
                return;
            }

            _sharedKey = AuthenticatorKeyFormatter.FormatKey(key);
            _otpAuthUri = AuthenticatorKeyFormatter.BuildOtpAuthUri(issuer, user.Email ?? email, key);
        });
    }
}
