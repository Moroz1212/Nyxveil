{
  "ConnectionStrings": {
    "ControlPlane": "Server=localhost;Database=NyxveilControlPlane;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True"
  },
  "Database": {
    "ConnectionString": "",
    "Encrypt": true,
    "TrustSqlServerCertificate": true
  },
  "Hosting": {
    "_comment": "Hosting is the single source of truth for Kestrel listen. Do not add Kestrel:Endpoints.",
    "BindAddress": "0.0.0.0",
    "Port": 8443,
    "PublicHostname": "localhost",
    "PublicBaseUrl": "https://localhost:8443"
  },
  "Certificate": {
    "Mode": "Store",
    "ValidationMode": "SystemTrust",
    "Thumbprint": "",
    "StoreName": "My",
    "StoreLocation": "LocalMachine",
    "PfxPath": "",
    "PfxPasswordProtectedPath": ""
  },
  "Https": {
    "RequireHttpsInProduction": true
  },
  "Setup": {
    "AllowWebBootstrap": false,
    "BootstrapToken": ""
  },
  "Signing": {
    "Issuer": "nyxveil-control-plane",
    "Audience": "nvp-node",
    "KeyProtectionPath": "%PROGRAMDATA%\\Nyxveil\\ControlPlane\\keys"
  },
  "Tickets": {
    "TtlMinutes": 15
  },
  "NodeAuth": {
    "AllowLegacyBearer": false
  },
  "NodeHeartbeat": {
    "IntervalSeconds": 30,
    "DegradedAfterSeconds": 90,
    "OfflineAfterSeconds": 180
  },
  "MetricsRetention": {
    "RawDays": 30,
    "SnapshotMinutes": 5
  },
  "RateLimits": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "Burst": 30,
    "TicketPermitLimit": 60,
    "TicketWindowSeconds": 60
  },
  "Security": {
    "LicenseKekHex": ""
  },
  "UI": {
    "AppName": "Nyxveil Control Plane",
    "SupportUrl": null,
    "ShowTestNodes": true,
    "PathBase": "/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Enabled": false,
      "Directory": "%PROGRAMDATA%\\Nyxveil\\ControlPlane\\logs",
      "FilePrefix": "controlplane",
      "MaxFileSizeMB": 10,
      "MaxRetainedFiles": 14
    }
  },
  "AllowedHosts": "*"
}
