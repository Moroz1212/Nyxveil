      Executing DbCommand [Parameters=[@licenseId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT "s"."LicenseId", "s"."ActivatedAt", "s"."CreatedAt", "s"."CreatedBy", "s"."ExpiresAt", "s"."ExternalPaymentId", "s"."LicenseKeyVerifier", "s"."MaxDevices", "s"."Note", "s"."PlanId", "s"."Role", "s"."Status", "s"."UpdatedAt", "s"."UserId", "s"."PlanId0", "s"."AllowedLocationsPolicy", "s"."Code", "s"."CreatedAt0", "s"."DurationDays", "s"."MaxDevices0", "s"."Name", "s"."Permissions", "s"."Status0", "s"."UpdatedAt0", "l0"."LicenseId", "l0"."LocationId"&#xD;
      FROM (&#xD;
          SELECT "l"."LicenseId", "l"."ActivatedAt", "l"."CreatedAt", "l"."CreatedBy", "l"."ExpiresAt", "l"."ExternalPaymentId", "l"."LicenseKeyVerifier", "l"."MaxDevices", "l"."Note", "l"."PlanId", "l"."Role", "l"."Status", "l"."UpdatedAt", "l"."UserId", "p"."PlanId" AS "PlanId0", "p"."AllowedLocationsPolicy", "p"."Code", "p"."CreatedAt" AS "CreatedAt0", "p"."DurationDays", "p"."MaxDevices" AS "MaxDevices0", "p"."Name", "p"."Permissions", "p"."Status" AS "Status0", "p"."UpdatedAt" AS "UpdatedAt0"&#xD;
          FROM "Licenses" AS "l"&#xD;
          INNER JOIN "Plans" AS "p" ON "l"."PlanId" = "p"."PlanId"&#xD;
          WHERE "l"."LicenseId" = @licenseId&#xD;
          LIMIT 1&#xD;
      ) AS "s"&#xD;
      LEFT JOIN "LicenseAllowedLocations" AS "l0" ON "s"."LicenseId" = "l0"."LicenseId"&#xD;
