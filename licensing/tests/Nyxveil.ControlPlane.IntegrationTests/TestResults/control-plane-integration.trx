      SELECT "n"."NodeId", "n"."AcmeAutoRenew", "n"."Capacity", "n"."CertIssuer", "n"."CertNotAfter", "n"."CertNotBefore", "n"."CertSan", "n"."CertSubject", "n"."CertThumbprint", "n"."ConfigVersion", "n"."CreatedAt", "n"."CurrentSessions", "n"."DeletedAt", "n"."DeletedBy", "n"."DeletionReason", "n"."DisplayName", "n"."Draining", "n"."Enabled", "n"."HealthStatus", "n"."LastBootId", "n"."LastRenewalAttempt", "n"."LastRenewalError", "n"."LastSeenAt", "n"."LastSuccessfulRenewal", "n"."LifecycleState", "n"."LocationId", "n"."ManagementCapabilities", "n"."NextPlannedRenewal", "n"."ProtocolVersion", "n"."PublicIdentity", "n"."ReportedServerVersion", "n"."ServerName", "n"."ServerVersion", "n"."SpkiPin", "n"."Status", "n"."SupportsNodeCommands", "n"."TestOnly", "n"."TlsMode", "n"."UpdatedAt", "n"."VersionReportedAt", "l"."LocationId", "n0"."Id", "n0"."AddressFamily", "n0"."Enabled", "n0"."Host", "n0"."NodeId", "n0"."Port", "n0"."Priority", "n1"."Id", "n1"."Enabled", "n1"."NodeId", "n1"."Priority", "n1"."TransportType", "l"."City", "l"."Code", "l"."Country", "l"."CountryCode", "l"."CreatedAt", "l"."DisplayName", "l"."Enabled", "l"."SortOrder", "l"."UpdatedAt"&#xD;
      FROM "Nodes" AS "n"&#xD;
      INNER JOIN "Locations" AS "l" ON "n"."LocationId" = "l"."LocationId"&#xD;
      LEFT JOIN "NodeEndpoints" AS "n0" ON "n"."NodeId" = "n0"."NodeId"&#xD;
      LEFT JOIN "NodeTransports" AS "n1" ON "n"."NodeId" = "n1"."NodeId"&#xD;
      WHERE "n"."LifecycleState" = 0&#xD;
      ORDER BY "n"."NodeId", "l"."LocationId", "n0"."Id"&#xD;
