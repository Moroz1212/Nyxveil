<UserControl x:Class="Nyxveil.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nyxveil.App.Controls"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Full-bleed atmosphere (reference: background continues behind cards) -->
    <Image Grid.RowSpan="2" Source="/Assets/Backgrounds/hero.png"
           Stretch="UniformToFill" VerticalAlignment="Top" HorizontalAlignment="Center"
           RenderOptions.BitmapScalingMode="HighQuality"/>
    <Border Grid.RowSpan="2">
      <Border.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
          <GradientStop Color="#18050A10" Offset="0"/>
          <GradientStop Color="#55061018" Offset="0.42"/>
          <GradientStop Color="#D2061018" Offset="0.68"/>
          <GradientStop Color="#FF061018" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,4">
      <Grid Margin="18,10,18,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: wordmark + top-right slogan (no overlap with mid slogans) -->
        <Grid Grid.Row="0" Margin="2,4,2,0">
          <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="Nyxveil" Style="{StaticResource BrandWordmark}"/>
            <TextBlock Text="С  В  О  Б  О  Д  А     З  А     П  Р  Е  Д  Е  Л  А  М  И"
                       Style="{StaticResource BrandTagline}" Margin="1,4,0,0"/>
          </StackPanel>
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,0,0">
            <TextBlock Text="БОЛЬШЕ" Style="{StaticResource SloganText}" TextAlignment="Right"/>
            <TextBlock Text="ЧЕМ VPN" Style="{StaticResource SloganText}" TextAlignment="Right"/>
            <Rectangle Width="40" Height="1" Fill="#88FFFFFF" HorizontalAlignment="Right" Margin="0,7,0,0"/>
          </StackPanel>
        </Grid>

        <!-- Row 1: left slogan | ring | right slogan -->
        <Grid Grid.Row="1" Margin="0,14,0,8" MinHeight="228">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="84"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,24,4,0" HorizontalAlignment="Left">
            <TextBlock Text="ТВОЁ" Style="{StaticResource SloganText}"/>
            <TextBlock Text="СОЕДИНЕНИЕ." Style="{StaticResource SloganText}"/>
            <TextBlock Text="ТВОИ" Style="{StaticResource SloganText}"/>
            <TextBlock Text="ГОРИЗОНТЫ." Style="{StaticResource SloganText}"/>
            <Rectangle Width="44" Height="1" Fill="#88FFFFFF" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>

          <controls:ConnectStatusRing Grid.Column="1"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      VisualState="{Binding Connection.RingVisual}"
                                      StatusText="{Binding Connection.StatusLabel}"
                                      TimerText="{Binding Connection.SessionTimerText}"/>

          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,24,0,0">
            <TextBlock Text="ПРИВАТНОСТЬ" Style="{StaticResource SloganText}" TextAlignment="Right"/>
            <TextBlock Text="БЕЗ ГРАНИЦ" Style="{StaticResource SloganText}" TextAlignment="Right"/>
            <Rectangle Width="44" Height="1" Fill="#88FFFFFF" HorizontalAlignment="Right" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Connection.ErrorBrief}" Foreground="{StaticResource ErrRed}"
                   TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,6">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Connection.ErrorBrief}" Value="">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- Server card -->
        <Border Grid.Row="3" Style="{StaticResource GlassCard}" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls:CountryFlagControl Grid.Column="0" CountryCode="{Binding Server.CountryCode}"
                                         FlagSize="42" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="ТЕКУЩИЙ СЕРВЕР" Style="{StaticResource SectionLabel}"/>
              <TextBlock Text="{Binding Server.CurrentTitle}" FontSize="15" FontWeight="SemiBold"
                         Foreground="{StaticResource FgPrimary}" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="{StaticResource FgMuted}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Server.QualityOk}" Value="True">
                          <Setter Property="Fill" Value="{StaticResource OkGreen}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Server.QualityText}" FontSize="12"
                           Foreground="{StaticResource AccentSoft}"/>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Content="Сменить сервер ›" Style="{StaticResource GhostButton}"
                    VerticalAlignment="Center" Click="ChangeServer_OnClick"/>
          </Grid>
        </Border>

        <!-- Stats + IP/Protocol (single visual block like reference) -->
        <Border Grid.Row="4" Style="{StaticResource GlassCard}" Margin="0,0,0,12" Padding="6,12,6,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <Image Source="{StaticResource IconClock}" Width="16" Height="16" HorizontalAlignment="Center"/>
                <TextBlock Text="ВРЕМЯ СЕССИИ" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,5,0,2"/>
                <TextBlock Text="{Binding Stats.Session}" Style="{StaticResource StatValue}" HorizontalAlignment="Center"/>
              </StackPanel>
              <Rectangle Grid.Column="1" Width="1" Fill="#2AFFFFFF" Margin="2,4"/>
              <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <Image Source="{StaticResource IconPing}" Width="16" Height="16" HorizontalAlignment="Center"/>
                <TextBlock Text="ПИНГ" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,5,0,2"/>
                <TextBlock Text="{Binding Stats.Ping}" Style="{StaticResource StatValue}" HorizontalAlignment="Center"/>
              </StackPanel>
              <Rectangle Grid.Column="3" Width="1" Fill="#2AFFFFFF" Margin="2,4"/>
              <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                <Image Source="{StaticResource IconDownload}" Width="16" Height="16" HorizontalAlignment="Center"/>
                <TextBlock Text="СКОРОСТЬ ↓" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,5,0,2"/>
                <TextBlock Text="{Binding Stats.Down}" Style="{StaticResource StatValue}" HorizontalAlignment="Center"/>
              </StackPanel>
              <Rectangle Grid.Column="5" Width="1" Fill="#2AFFFFFF" Margin="2,4"/>
              <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                <Image Source="{StaticResource IconUpload}" Width="16" Height="16" HorizontalAlignment="Center"/>
                <TextBlock Text="СКОРОСТЬ ↑" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,5,0,2"/>
                <TextBlock Text="{Binding Stats.Up}" Style="{StaticResource StatValue}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="8,10,8,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <StackPanel>
                    <TextBlock Text="МОЙ VPN IP" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Stats.VpnIp}" FontSize="14" FontWeight="SemiBold"
                                 Foreground="{StaticResource FgPrimary}" VerticalAlignment="Center"/>
                      <Button ToolTip="Копировать VPN IP" Margin="8,0,0,0"
                              Style="{StaticResource GhostButton}" Padding="6,2" Click="CopyIp_OnClick">
                        <Image Source="{StaticResource IconCopy}" Width="12" Height="12"/>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <Rectangle Grid.Column="1" Width="1" Fill="#2AFFFFFF" Margin="10,2"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock Text="ПРОТОКОЛ" Style="{StaticResource SectionLabel}"/>
                  <TextBlock Text="{Binding Stats.Protocol}" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource FgPrimary}"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Button Grid.Row="5" Style="{StaticResource CtaButton}" Margin="0,0,0,12"
                IsEnabled="{Binding Connection.CtaEnabled}" Click="Cta_OnClick">
          <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource IconPower}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Connection.CtaText}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <UniformGrid Grid.Row="6" Columns="4" Margin="0,0,0,6">
          <Button Style="{StaticResource NavCard}" Margin="0,0,5,0" Click="NavSettings_OnClick" Height="74">
            <StackPanel>
              <Image Source="{StaticResource IconGear}" Width="20" Height="20" HorizontalAlignment="Center"/>
              <TextBlock Text="Настройки" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource NavCard}" Margin="2.5,0" Click="NavDiag_OnClick" Height="74">
            <StackPanel>
              <Image Source="{StaticResource IconDiagnostics}" Width="20" Height="20" HorizontalAlignment="Center"/>
              <TextBlock Text="Диагностика" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource NavCard}" Margin="2.5,0" Click="NavLogs_OnClick" Height="74">
            <StackPanel>
              <Image Source="{StaticResource IconLogs}" Width="20" Height="20" HorizontalAlignment="Center"/>
              <TextBlock Text="Логи" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource NavCard}" Margin="5,0,0,0" Click="NavMore_OnClick" Height="74">
            <StackPanel>
              <Image Source="{StaticResource IconMore}" Width="20" Height="20" HorizontalAlignment="Center"/>
              <TextBlock Text="Ещё" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/>
            </StackPanel>
          </Button>
        </UniformGrid>
      </Grid>
    </ScrollViewer>

    <Grid Grid.Row="1" Margin="18,2,18,10">
      <TextBlock Text="{Binding FooterVersion}" Foreground="{StaticResource FgMuted}" FontSize="11"
                 VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Ellipse Width="7" Height="7" Fill="{Binding HealthBrush}" Margin="0,0,6,0"/>
        <TextBlock Text="{Binding HealthText}" Foreground="{StaticResource FgMuted}" FontSize="11"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
