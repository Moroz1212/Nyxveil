<UserControl x:Class="Nyxveil.App.Views.MoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="16">
    <StackPanel>
      <DockPanel Margin="0,0,0,16">
        <Button Content="← Назад" Style="{StaticResource GhostButton}" Click="Back_OnClick"/>
        <TextBlock Text="Ещё" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource FgPrimary}"
                   Margin="12,0,0,0" VerticalAlignment="Center"/>
      </DockPanel>
      <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="О программе" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding More.About}" TextWrapping="Wrap" Foreground="{StaticResource FgPrimary}" LineHeight="20"/>
        </StackPanel>
      </Border>
      <TextBlock Text="Проверка обновлений и внешние ссылки появятся, когда будут доступны официальные endpoint'ы Nyxveil."
                 Foreground="{StaticResource FgMuted}" TextWrapping="Wrap" FontSize="12"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
