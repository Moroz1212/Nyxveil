<UserControl x:Class="Nyxveil.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <DockPanel Margin="0,0,0,16">
        <Button Content="← Назад" Style="{StaticResource GhostButton}" Click="Back_OnClick"/>
        <TextBlock Text="Настройки" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource FgPrimary}"
                   Margin="12,0,0,0" VerticalAlignment="Center"/>
      </DockPanel>
      <Border Style="{StaticResource GlassCard}" Margin="0,0,0,10">
        <StackPanel>
          <CheckBox Content="Запускать вместе с Windows" IsChecked="{Binding Settings.Autostart}" Margin="0,0,0,10"/>
          <CheckBox Content="Автоподключение к последнему серверу" IsChecked="{Binding Settings.AutoConnect}" Margin="0,0,0,10"/>
          <CheckBox Content="Запускать свёрнутым" IsChecked="{Binding Settings.StartMinimized}" Margin="0,0,0,10"/>
          <CheckBox Content="Показывать уведомления" IsChecked="{Binding Settings.Notifications}" Margin="0,0,0,10"/>
          <CheckBox Content="Автопрокрутка логов" IsChecked="{Binding Logs.AutoScroll}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource GlassCard}" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="Внешний вид" Style="{StaticResource SectionLabel}"/>
          <TextBlock Text="{Binding Settings.Appearance}" Foreground="{StaticResource FgPrimary}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Button Content="Сохранить" Style="{StaticResource CtaButton}" Click="Save_OnClick"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
