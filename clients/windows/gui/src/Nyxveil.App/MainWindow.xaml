<Window x:Class="Nyxveil.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nyxveil" Height="600" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI Variable, Segoe UI"
        ResizeMode="CanMinimize">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Nyxveil" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/>

    <ComboBox x:Name="LocationBox" Grid.Row="1" Height="36" Margin="0,0,0,24"
              IsEditable="False" FontSize="14"/>

    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
      <Ellipse x:Name="StatusDot" Width="18" Height="18" Fill="#6B7280" Margin="0,0,0,24"/>
      <Button x:Name="ConnectButton" Content="ПОДКЛЮЧИТЬ" Width="220" Height="48"
              FontSize="16" FontWeight="SemiBold" Click="ConnectButton_OnClick"
              Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"/>
    </StackPanel>

    <TextBlock x:Name="StatusText" Grid.Row="3" Text="Статус: Отключено"
               HorizontalAlignment="Center" Margin="0,16,0,8" FontSize="14" Opacity="0.85"/>
    <TextBlock x:Name="DetailText" Grid.Row="4" Text=""
               HorizontalAlignment="Center" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
    <TextBlock x:Name="ErrorText" Grid.Row="5" Text="" Foreground="#E57373"
               HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"/>

    <CheckBox x:Name="AutostartBox" Grid.Row="6" Content="Запускать вместе с Windows"
              Margin="0,16,0,8" Checked="AutostartBox_OnChanged" Unchecked="AutostartBox_OnChanged"/>

    <Expander Grid.Row="7" Header="Диагностика" Margin="0,8,0,0" IsExpanded="False">
      <TextBlock x:Name="DiagText" FontFamily="Consolas" FontSize="11" Opacity="0.75"
                 TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Expander>
  </Grid>
</Window>
